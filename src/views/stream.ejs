<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - CoWatch</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📺</text></svg>">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0a0a0a; color: #e4e4e7; min-height: 100vh; }
    .page { max-width: 1000px; margin: 0 auto; padding: 32px 24px; }
    .back { color: #71717a; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 20px; }
    .back:hover { color: #fff; text-decoration: none; }
    .header { margin-bottom: 24px; }
    .header h1 { font-size: 24px; font-weight: 700; }
    .card { background: #111; border: 1px solid #222; border-radius: 10px; padding: 24px; margin-bottom: 20px; }
    .card h2 { font-size: 16px; margin-bottom: 16px; }
    .status-bar { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
    .dot { width: 10px; height: 10px; border-radius: 50%; }
    .dot-live { background: #22c55e; box-shadow: 0 0 8px #22c55e; animation: pulse 2s infinite; }
    .dot-idle { background: #52525b; }
    .dot-ended { background: #991b1b; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.5} }
    .viewer-count { font-size: 13px; color: #a1a1aa; }
    .viewer-count span { color: #fff; font-weight: 600; }
    .btn { padding: 10px 20px; border: none; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; }
    .btn-green { background: #16a34a; color: #fff; }
    .btn-green:hover { background: #15803d; }
    .btn-red { background: #dc2626; color: #fff; }
    .btn-red:hover { background: #b91c1c; }
    .btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; font-size: 14px; }
    .info-grid dt { color: #71717a; }
    .info-grid dd { color: #fff; }
    .live-link { display: inline-block; margin-top: 12px; padding: 8px 16px; background: #18181b; border: 1px solid #27272a; border-radius: 6px; color: #3b82f6; font-size: 13px; word-break: break-all; }
    .live-link:hover { border-color: #3b82f6; }
    #video-container { width: 100%; aspect-ratio: 16/9; background: #000; border-radius: 8px; overflow: hidden; margin-bottom: 16px; display: none; }
    #video-container video { width: 100%; height: 100%; object-fit: contain; }
    #screen-preview { width: 100%; aspect-ratio: 16/9; background: #000; border-radius: 8px; overflow: hidden; margin-bottom: 16px; display: none; }
    #screen-preview video { width: 100%; height: 100%; object-fit: contain; }
    .share-bar { display: flex; align-items: center; gap: 12px; margin-top: 16px; flex-wrap: wrap; }
    .share-status { font-size: 13px; color: #a1a1aa; display: flex; align-items: center; gap: 6px; }
    .share-status .dot { width: 8px; height: 8px; }
    .btn-blue { background: #3b82f6; color: #fff; }
    .btn-blue:hover { background: #2563eb; }
    .btn-orange { background: #ea580c; color: #fff; }
    .btn-orange:hover { background: #c2410c; }
  </style>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="page">
    <a href="/dashboard" class="back">← Back to Dashboard</a>
    <div class="header">
      <h1><%= stream.title %></h1>
    </div>

    <div class="card">
      <div class="status-bar">
        <div class="dot dot-<%= stream.status %>"></div>
        <span style="font-size:14px;font-weight:600;text-transform:uppercase"><%= stream.status %></span>
        <div class="viewer-count" id="viewer-count" style="display:none">
          <span id="viewer-num">0</span> watching
        </div>
      </div>

      <div class="info-grid">
        <div><dt>Stream Key</dt><dd style="font-family:monospace;font-size:13px;margin-top:4px"><%= stream.streamKey %></dd></div>
        <div><dt>Created</dt><dd style="margin-top:4px"><%= new Date(stream.createdAt).toLocaleString() %></dd></div>
        <% if (stream.startedAt) { %>
          <div><dt>Started</dt><dd style="margin-top:4px"><%= new Date(stream.startedAt).toLocaleString() %></dd></div>
        <% } %>
        <% if (stream.duration) { %>
          <div><dt>Duration</dt><dd style="margin-top:4px"><%= Math.floor(stream.duration / 60) %>m <%= stream.duration % 60 %>s</dd></div>
        <% } %>
      </div>

      <% if (stream.status === 'active') { %>
        <div class="live-link" id="live-link">
          Live URL: <%= APP_URL %>/live/<%= stream.streamKey %>
        </div>
      <% } %>

      <div style="margin-top:20px;display:flex;gap:8px">
        <% if (stream.status === 'idle') { %>
          <button class="btn btn-green" id="start-btn" onclick="startStream()">Start Stream</button>
        <% } else if (stream.status === 'active') { %>
          <button class="btn btn-red" id="end-btn" onclick="endStream()">End Stream</button>
        <% } %>
      </div>

      <% if (stream.status === 'active') { %>
      <div class="share-bar">
        <button class="btn btn-blue" id="share-btn" onclick="toggleScreenShare()">Share Screen</button>
        <div class="share-status" id="share-status" style="display:none">
          <div class="dot dot-idle" id="share-dot"></div>
          <span id="share-label">Initializing...</span>
        </div>
      </div>
      <div id="screen-preview">
        <video id="screen-video" autoplay muted playsinline></video>
      </div>
      <% } %>
    </div>

    <% if (stream.status === 'active') { %>
      <div class="card">
        <h2>Live Preview</h2>
        <div id="video-container">
          <video id="video-player" controls autoplay muted></video>
        </div>
        <p style="color:#52525b;font-size:12px;margin-top:8px">HLS preview loads after a few seconds of streaming.</p>
      </div>
    <% } %>

    <div class="card">
      <h2>Broadcasting Instructions</h2>
      <p style="font-size:13px;color:#a1a1aa;margin-bottom:12px"><strong>Option 1 — Share Screen (browser):</strong> Start the stream, then click <em>Share Screen</em> above to broadcast directly from your browser.</p>
      <p style="font-size:13px;color:#a1a1aa;margin-bottom:12px"><strong>Option 2 — OBS Studio / RTMP:</strong></p>
      <div class="info-grid">
        <div><dt>Server URL</dt><dd style="font-family:monospace;font-size:12px;margin-top:4px"><%= APP_URL %>/stream</dd></div>
        <div><dt>Stream Key</dt><dd style="font-family:monospace;font-size:12px;margin-top:4px"><%= stream.streamKey %></dd></div>
      </div>
    </div>
  </div>

  <%- include('partials/toast') %>
  <script>
    const streamStatus = '<%= stream.status %>';
    const hlsBaseUrl = '<%= process.env.HLS_CDN_URL || "/live" %>';
    const streamKey = '<%= stream.streamKey %>';

    // Viewer count WebSocket
    if (streamStatus === 'active') {
      const viewerCount = document.getElementById('viewer-count');
      const viewerNum = document.getElementById('viewer-num');
      viewerCount.style.display = 'block';

      const proto = location.protocol === 'https:' ? 'wss' : 'ws';
      const vws = new WebSocket(`${proto}://${location.host}/status-ws`);
      vws.onmessage = (e) => {
        try {
          const msg = JSON.parse(e.data);
          if (msg.type === 'VIEWER_COUNT') {
            viewerNum.textContent = msg.count;
          }
        } catch(err) {}
      };

      // HLS preview
      setTimeout(() => {
        const video = document.getElementById('video-player');
        const container = document.getElementById('video-container');
        if (video && container) {
          container.style.display = 'block';
          if (video.canPlayType('application/vnd.apple.mpegurl')) {
            video.src = hlsBaseUrl + '/stream_1080p.m3u8';
          } else if (typeof Hls !== 'undefined' && Hls.isSupported()) {
            const hls = new Hls({ maxBufferLength: 4 });
            hls.loadSource(hlsBaseUrl + '/stream_1080p.m3u8');
            hls.attachMedia(video);
          }
        }
      }, 5000);
    }

    async function startStream() {
      const btn = document.getElementById('start-btn');
      btn.disabled = true;
      try {
        const res = await fetch('/stream/<%= stream.id %>/start', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          await fetch('/reset-stream', { method: 'POST' }).catch(() => {});
          showToast('Stream started!', 'success');
          setTimeout(() => location.reload(), 500);
        } else {
          showToast(data.message || 'Failed to start', 'error');
          btn.disabled = false;
        }
      } catch (e) { showToast('Network error', 'error'); btn.disabled = false; }
    }

    async function endStream() {
      if (!confirm('End this stream?')) return;
      const btn = document.getElementById('end-btn');
      btn.disabled = true;
      try {
        if (screenRecorder && screenRecorder.state === 'recording') stopScreenShare();
        await fetch('/stop-stream', { method: 'POST' }).catch(() => {});
        const res = await fetch('/stream/<%= stream.id %>/end', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          showToast('Stream ended', 'success');
          setTimeout(() => location.reload(), 500);
        } else {
          showToast('Failed to end', 'error');
          btn.disabled = false;
        }
      } catch (e) { showToast('Network error', 'error'); btn.disabled = false; }
    }

    // --- Screen Share ---
    let screenWs = null;
    let screenRecorder = null;
    let screenStream = null;

    function updateShareUI(state, label) {
      const dot = document.getElementById('share-dot');
      const lbl = document.getElementById('share-label');
      const btn = document.getElementById('share-btn');
      const status = document.getElementById('share-status');
      if (!dot || !lbl || !btn) return;
      status.style.display = 'flex';
      lbl.textContent = label;
      dot.className = 'dot';
      if (state === 'live') { dot.classList.add('dot-live'); btn.textContent = 'Stop Sharing'; btn.className = 'btn btn-orange'; }
      else if (state === 'idle') { dot.classList.add('dot-idle'); btn.textContent = 'Share Screen'; btn.className = 'btn btn-blue'; }
      else if (state === 'error') { dot.classList.add('dot-ended'); btn.textContent = 'Share Screen'; btn.className = 'btn btn-blue'; }
    }

    async function toggleScreenShare() {
      if (screenRecorder && screenRecorder.state === 'recording') {
        stopScreenShare();
        return;
      }
      try {
        let withAudio = true;
        try {
          screenStream = await navigator.mediaDevices.getDisplayMedia({ video: { cursor: 'always', width: { ideal: 1920 }, height: { ideal: 1080 }, frameRate: { ideal: 30 } }, audio: true });
        } catch (e) {
          withAudio = false;
          screenStream = await navigator.mediaDevices.getDisplayMedia({ video: { cursor: 'always', width: { ideal: 1920 }, height: { ideal: 1080 }, frameRate: { ideal: 30 } }, audio: false });
        }

        if (!withAudio) {
          const audioCtx = new AudioContext();
          const dest = audioCtx.createMediaStreamDestination();
          const silent = audioCtx.createBufferSource();
          silent.buffer = audioCtx.createBuffer(1, audioCtx.sampleRate * 2, audioCtx.sampleRate);
          silent.loop = true;
          silent.connect(dest);
          silent.start();
          const audioTrack = dest.stream.getAudioTracks()[0];
          screenStream.addTrack(audioTrack);
        }

        const preview = document.getElementById('screen-video');
        preview.srcObject = screenStream;
        document.getElementById('screen-preview').style.display = 'block';

        screenStream.getVideoTracks()[0].onended = () => stopScreenShare();

        const proto = location.protocol === 'https:' ? 'wss' : 'ws';
        screenWs = new WebSocket(`${proto}://${location.host}/stream-ws`);
        screenWs.onopen = () => {
          const mimeType = MediaRecorder.isTypeSupported('video/webm; codecs=vp9')
            ? 'video/webm; codecs=vp9'
            : 'video/webm; codecs=vp8';
          screenRecorder = new MediaRecorder(screenStream, { mimeType, videoBitsPerSecond: 4000000 });
          screenRecorder.ondataavailable = (e) => {
            if (e.data.size > 0 && screenWs && screenWs.readyState === 1) {
              e.data.arrayBuffer().then(buf => screenWs.send(buf));
            }
          };
          screenRecorder.start(500);
          updateShareUI('live', 'Sharing screen');
          showToast('Screen sharing started', 'success');
        };
        screenWs.onerror = () => { updateShareUI('error', 'WebSocket error'); };
        screenWs.onclose = () => { if (screenRecorder && screenRecorder.state === 'recording') stopScreenShare(); };
      } catch (err) {
        if (err.name !== 'AbortError') {
          updateShareUI('error', 'Could not start: ' + err.message);
          showToast('Screen share failed', 'error');
        }
      }
    }

    function stopScreenShare() {
      if (screenRecorder && screenRecorder.state === 'recording') screenRecorder.stop();
      if (screenStream) screenStream.getTracks().forEach(t => t.stop());
      if (screenWs && screenWs.readyState === 1) screenWs.close();
      screenRecorder = null;
      screenStream = null;
      screenWs = null;
      const preview = document.getElementById('screen-video');
      if (preview) preview.srcObject = null;
      document.getElementById('screen-preview').style.display = 'none';
      updateShareUI('idle', 'Sharing stopped');
    }

    window.addEventListener('beforeunload', () => {
      if (screenRecorder && screenRecorder.state === 'recording') stopScreenShare();
    });
  </script>
</body>
</html>
