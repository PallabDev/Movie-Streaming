<nav style="background:#111;border-bottom:1px solid #222;padding:16px 0;position:sticky;top:0;z-index:100">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between">
    <a href="/" style="font-size:20px;font-weight:700;color:#fff;text-decoration:none;display:flex;align-items:center;gap:8px">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="15" x="2" y="7" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
      CoWatch
    </a>
    <div style="display:flex;align-items:center;gap:16px">
      <% if (user) { %>
        <a href="/dashboard" style="color:#a1a1aa;text-decoration:none;font-size:14px">Dashboard</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin" style="color:#a1a1aa;text-decoration:none;font-size:14px">Admin</a>
        <% } %>
        <span style="color:#52525b;font-size:14px"><%= user.name %></span>
        <a href="/auth/logout" style="color:#52525b;font-size:14px;text-decoration:none">Logout</a>
      <% } else { %>
        <a href="/login" style="color:#a1a1aa;text-decoration:none;font-size:14px">Login</a>
        <a href="/register" style="color:#fff;background:#3b82f6;padding:6px 16px;border-radius:6px;font-size:14px;text-decoration:none">Register</a>
      <% } %>
    </div>
  </div>
</nav>
