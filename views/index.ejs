<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Screen Share Studio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #090d16;
            --card-bg: rgba(17, 24, 39, 0.75);
            --primary: #6366f1;
            --primary-hover: #4f46e5;
            --danger: #ef4444;
            --danger-hover: #dc2626;
            --success: #10b981;
            --text-main: #f3f4f6;
            --text-sub: #9ca3af;
            --border-glass: rgba(255, 255, 255, 0.08);
            --shadow-glow: rgba(99, 102, 241, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem 2rem 6rem 2rem;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient background glow */
        .ambient-glow {
            position: absolute;
            top: 20%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, var(--shadow-glow) 0%, rgba(9, 13, 22, 0) 70%);
            pointer-events: none;
            z-index: 0;
        }

        /* Main Container */
        .app-container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 880px;
            /* reduced to make room for top status box */
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 2rem;
        }

        /* 16:9 Video Player Container */
        .player-wrapper {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #030712;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--border-glass);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        video {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: none;
        }

        video.active {
            display: block;
        }

        /* Placeholder State */
        .placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            color: var(--text-sub);
            text-align: center;
            padding: 2rem;
        }

        .placeholder-icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .placeholder-icon svg {
            width: 32px;
            height: 32px;
            fill: none;
            stroke: var(--text-sub);
            stroke-width: 1.8;
        }

        .placeholder h2 {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .placeholder p {
            font-size: 0.9rem;
            color: var(--text-sub);
        }

        /* Custom Player Controls Overlay */
        .controls-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0) 100%);
            padding: 1.5rem 1.5rem 1rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        .player-wrapper:hover .controls-overlay,
        .controls-overlay.visible {
            opacity: 1;
            pointer-events: auto;
        }

        .controls-left,
        .controls-right {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .control-btn {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            color: var(--text-main);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            backdrop-filter: blur(8px);
            transition: all 0.2s ease;
        }

        .control-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.05);
        }

        .control-btn svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
        }

        /* Badges */
        .badge-container {
            position: absolute;
            top: 1rem;
            left: 1rem;
            display: flex;
            gap: 0.5rem;
            z-index: 5;
        }

        .badge-live {
            background: rgba(239, 68, 68, 0.9);
            color: white;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            text-transform: uppercase;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }

        .badge-live::before {
            content: '';
            width: 6px;
            height: 6px;
            background: white;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        .badge-quality {
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #60a5fa;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-chunks {
            background: rgba(16, 185, 129, 0.2);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #34d399;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        @keyframes pulse {
            0% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.4;
                transform: scale(0.8);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* Floating Action Buttons Container fixed at Bottom Center */
        .action-button-container {
            position: fixed;
            left: 50%;
            bottom: 2rem;
            transform: translateX(-50%);
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .btn-action {
            padding: 0.9rem 2rem;
            border-radius: 50px;
            border: none;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-share.start {
            background: linear-gradient(135deg, var(--primary) 0%, #a855f7 100%);
            color: white;
            box-shadow: 0 10px 30px var(--shadow-glow);
        }

        .btn-share.start:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(99, 102, 241, 0.4);
        }

        .btn-share.stop {
            background: linear-gradient(135deg, var(--danger) 0%, #b91c1c 100%);
            color: white;
            box-shadow: 0 10px 30px rgba(239, 68, 68, 0.4);
        }

        .btn-share.stop:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(239, 68, 68, 0.6);
        }

        .btn-download {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);
        }

        .btn-download:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(16, 185, 129, 0.5);
        }

        .btn-action svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
        }
    </style>
    <style>
        /* Extra player UI improvements */
        .controls-overlay {
            transition: opacity 0.25s ease, transform 0.2s ease;
            will-change: opacity;
        }

        .controls-overlay.visible {
            opacity: 1 !important;
            transform: translateY(0);
        }

        .controls-overlay.hidden {
            opacity: 0;
            transform: translateY(6px);
        }
    </style>
</head>

<body>
    <div class="ambient-glow"></div>

    <!-- Stream Initialization Loader Modal -->
    <div id="streamLoaderModal"
        style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); z-index: 9999; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 20px;">
        <div
            style="width: 54px; height: 54px; border: 4px solid rgba(99, 102, 241, 0.2); border-top-color: #6366f1; border-radius: 50%; animation: spin 0.9s linear infinite; margin-bottom: 20px;">
        </div>
        <h3 id="loaderTitle"
            style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0 0 8px 0; font-family: system-ui, sans-serif;">
            Initializing Live Stream Engine...</h3>
        <p id="loaderSubtitle"
            style="font-size: 0.875rem; color: #94a3b8; max-width: 420px; margin: 0; font-family: system-ui, sans-serif; line-height: 1.5;">
            Purging old video segments from cloud storage and initializing real-time encoder...</p>
    </div>

    <div class="app-container">
        <!-- Top Status Box (top-center outside player) -->
        <div id="topStatusBox"
            style="width:100%; display:flex; justify-content:center; margin-bottom:12px; display:none; pointer-events:auto;">
            <div style="display:flex; gap:8px; align-items:center; justify-content:center;">
                <div
                    style="padding:8px 14px; background:rgba(15,23,42,0.95); border-radius:12px; border:1px solid rgba(255,255,255,0.04); display:flex; align-items:center; gap:10px; box-shadow:0 8px 24px rgba(0,0,0,0.55);">
                    <span style="display:inline-flex; align-items:center; gap:8px;">
                        <span
                            style="width:10px;height:10px;background:#ef4444;border-radius:999px;display:inline-block;box-shadow:0 0 6px rgba(239,68,68,0.5);"></span>
                        <strong style="color:#fff; font-size:13px;">LIVE</strong>
                    </span>
                    <span id="topQualityBadge"
                        style="background:#0f172a;color:#9fc7ff;padding:6px 10px;border-radius:10px;font-size:13px;border:1px solid rgba(255,255,255,0.04);">720p
                        WebRTC</span>
                    <span id="topConnBadge"
                        style="background:#072f18;color:#9fe6c4;padding:6px 10px;border-radius:10px;font-size:13px;border:1px solid rgba(255,255,255,0.04);display:flex;align-items:center;gap:6px;">
                        <span id="connDot" style="width:8px;height:8px;border-radius:50%;background:#10b981;display:inline-block;"></span>
                        <span id="connText">Stable Connection</span>
                    </span>
                </div>
            </div>
        </div>

        <!-- Throttle Warning Overlay -->
        <div id="throttleOverlay" style="display:none; width:100%; margin-bottom:12px; pointer-events:none;">
            <div style="padding:10px 18px; background:rgba(153,27,27,0.9); border-radius:12px; border:1px solid rgba(239,68,68,0.4); display:flex; align-items:center; gap:10px; box-shadow:0 8px 24px rgba(0,0,0,0.55); animation: throttlePulse 1.5s ease-in-out infinite;">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="#fca5a5" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <span style="color:#fca5a5; font-size:13px; font-weight:600;">Poor Upload — Chunks paused. Check your internet connection.</span>
            </div>
        </div>
        <style>@keyframes throttlePulse { 0%,100%{ opacity:1; } 50%{ opacity:0.7; } }</style>

        <!-- 16:9 Video Player -->
        <div class="player-wrapper" id="playerWrapper">


            <!-- 16:9 Video Player -->


            <!-- Placeholder State -->
            <div class="placeholder" id="placeholder">
                <div class="placeholder-icon">
                    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                </div>
                <h2>No Screen Shared</h2>
                <p>Click "Share Screen" below to stream high quality chunks to server</p>
            </div>

            <!-- Video Player -->
            <video id="previewVideo" autoplay playsinline muted></video>


            <!-- Custom Controls Overlay -->
            <div class="controls-overlay" id="controlsOverlay">
                <div class="controls-left">
                    <!-- Play / Pause button: only this toggles playback -->
                    <button class="control-btn" id="playPauseBtn" title="Play / Pause" style="width:48px;height:48px;">
                        <svg id="playIcon" viewBox="0 0 24 24">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        <svg id="pauseIcon" viewBox="0 0 24 24" style="display: none;">
                            <rect x="6" y="4" width="4" height="16"></rect>
                            <rect x="14" y="4" width="4" height="16"></rect>
                        </svg>
                    </button>

                    <button class="control-btn" id="muteBtn" title="Mute/Unmute Audio">
                        <svg id="unmutedIcon" viewBox="0 0 24 24">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                        </svg>
                        <svg id="mutedIcon" viewBox="0 0 24 24" style="display: none;">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                            <line x1="23" y1="9" x2="17" y2="15"></line>
                            <line x1="17" y1="9" x2="23" y2="15"></line>
                        </svg>
                    </button>
                </div>
                <div class="controls-right">
                    <button class="control-btn" id="fullscreenBtn" title="Toggle Fullscreen">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3">
                            </path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Compact Floating Action Bar (Fixed at Bottom Center) -->
    <div id="buttonContainer" class="action-button-container"
        style="gap: 12px; padding: 8px 16px; border-radius: 9999px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
        <a href="/" title="Home Dashboard"
            style="width: 42px; height: 42px; border-radius: 50%; background: rgba(255, 255, 255, 0.1); color: #ffffff; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease;">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
        </a>

        <button id="toggleShareBtn" class="btn-action btn-share start" title="Start / Stop Sharing"
            style="padding: 8px 18px; border-radius: 9999px; font-size: 0.85rem;">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            <span id="btnText">Share Screen</span>
        </button>

        <a id="watchLiveBtn" href="#" title="Copy Stream Link"
            style="width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: white; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); cursor: pointer;">
            <!-- Standard Share Icon (arrow out of box) from Feather/typical sets -->
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"></path>
                <polyline points="16 6 12 2 8 6"></polyline>
                <line x1="12" y1="2" x2="12" y2="15"></line>
            </svg>
        </a>
    </div>

    <script>
        const toggleShareBtn = document.getElementById('toggleShareBtn');
        const downloadBtn = document.getElementById('downloadBtn');
        const btnText = document.getElementById('btnText');
        const previewVideo = document.getElementById('previewVideo');
        const placeholder = document.getElementById('placeholder');
        const topStatusBox = document.getElementById('topStatusBox');
        const topQualityBadge = document.getElementById('topQualityBadge');
        const topChunksBadge = document.getElementById('topChunksBadge');
        const playerWrapper = document.getElementById('playerWrapper');
        const connDot = document.getElementById('connDot');
        const connText = document.getElementById('connText');

        // Controls
        const playPauseBtn = document.getElementById('playPauseBtn');
        const playIcon = document.getElementById('playIcon');
        const pauseIcon = document.getElementById('pauseIcon');
        const muteBtn = document.getElementById('muteBtn');
        const unmutedIcon = document.getElementById('unmutedIcon');
        const mutedIcon = document.getElementById('mutedIcon');
        const fullscreenBtn = document.getElementById('fullscreenBtn');

        let mediaStream = null;
        let mediaRecorder = null;
        let captureStatsInterval = null;
        let chunkIndex = 0;
        let isPageUnloading = false;
        let isThrottled = false;

        // ─── Stream Settings ──────────────────────────────────────────────
        const STREAM_TARGET = {
            width: 1280,
            height: 720,
            fps: 30,
            bitrate: 6000000
        };

        let streamQuality = STREAM_TARGET.height;
        let streamBitrate = Math.round(STREAM_TARGET.bitrate / 1000);
        let throttleSoundPlayed = false;
        let _settingsRestartPending = false;

        const throttleOverlay = document.getElementById('throttleOverlay');

        function sendSettingsToServer() {
            if (streamWs && streamWs.readyState === WebSocket.OPEN) {
                streamWs.send(JSON.stringify({
                    type: 'HOST_MEDIA_SETTINGS',
                    quality: streamQuality,
                    bitrate: streamBitrate
                }));
            }
        }

        window.addEventListener('pagehide', () => {
            isPageUnloading = true;
        });

        window.addEventListener('beforeunload', (e) => {
            if (mediaStream && mediaRecorder && mediaRecorder.state !== 'inactive') {
                isPageUnloading = true;
                e.preventDefault();
                e.returnValue = '';
                return '';
            }
        });

        // Player control helpers
        function updatePlayPauseUI() {
            try {
                if (!previewVideo) return;
                if (previewVideo.paused) {
                    playIcon.style.display = 'block';
                    pauseIcon.style.display = 'none';
                } else {
                    playIcon.style.display = 'none';
                    pauseIcon.style.display = 'block';
                }
            } catch (e) { }
        }

        // Only the play/pause button toggles playback. Prevent clicks on the player area from toggling.
        if (playPauseBtn) {
            playPauseBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (previewVideo.paused) {
                    previewVideo.play().catch(() => { });
                } else {
                    previewVideo.pause();
                }
                updatePlayPauseUI();
                // keep controls visible briefly on interaction
                showControlsTransient();
            });
        }

        previewVideo.addEventListener('play', updatePlayPauseUI);
        previewVideo.addEventListener('pause', updatePlayPauseUI);

        // Prevent native or accidental clicks on the player from toggling playback
        // Use capture listeners so they run before default browser handlers
        ['click', 'pointerdown', 'pointerup', 'touchend'].forEach(evt => {
            playerWrapper.addEventListener(evt, (e) => {
                // allow interactions that are inside the controls overlay or interactive elements
                if (e.target && e.target.closest && e.target.closest('#controlsOverlay')) return;
                // allow clicks on links/buttons within overlays
                if (e.target && (e.target.tagName === 'BUTTON' || e.target.tagName === 'A' || e.target.closest('button') || e.target.closest('a'))) return;
                try { e.stopImmediatePropagation(); } catch (_) { }
                e.stopPropagation();
                e.preventDefault();
            }, true); // capture=true

            previewVideo.addEventListener(evt, (e) => {
                try { e.stopImmediatePropagation(); } catch (_) { }
                e.stopPropagation();
                e.preventDefault();
            }, true); // capture=true
        });


        // Mobile: auto-hide controls after 3 seconds of inactivity
        const isMobile = ('ontouchstart' in window) || (navigator.maxTouchPoints && navigator.maxTouchPoints > 0) || window.matchMedia('(pointer:coarse)').matches;
        let controlsHideTimer = null;
        function showControlsTransient() {
            if (!controlsOverlay) return;
            controlsOverlay.classList.add('visible');
            if (controlsHideTimer) clearTimeout(controlsHideTimer);
            if (isMobile) {
                controlsHideTimer = setTimeout(() => {
                    controlsOverlay.classList.remove('visible');
                }, 3000);
            }
        }

        // Show controls on touch / interaction; on desktop hover still works via CSS
        ['touchstart', 'mousemove'].forEach(evt => {
            playerWrapper.addEventListener(evt, (e) => {
                // if desktop and mousemove, don't force visibility (hover covers it)
                if (!isMobile && evt === 'mousemove') return;
                // ignore interactions that originated inside the controls themselves
                if (e.target.closest && e.target.closest('#controlsOverlay')) return;
                showControlsTransient();
            }, { passive: true });
        });

        // Reset hide timer when interacting with controls
        [playPauseBtn, muteBtn, fullscreenBtn].forEach(btn => {
            if (!btn) return;
            btn.addEventListener('click', () => showControlsTransient());
        });

        // ensure UI state set on init
        updatePlayPauseUI();


        toggleShareBtn.addEventListener('click', () => {
            if (mediaStream) {
                stopSharing();
            } else {
                startSharing();
            }
        });

        const currentStreamKey = '<%= typeof streamKey !== "undefined" ? streamKey : "default" %>';
        let streamWs = null;

        let peerConnection = null;

        function preferVideoCodec(transceiver) {
            try {
                if (!transceiver || !RTCRtpSender.getCapabilities) return;
                const capabilities = RTCRtpSender.getCapabilities('video');
                if (!capabilities || !Array.isArray(capabilities.codecs)) return;
                const codecs = capabilities.codecs;
                const preferred = codecs.filter(codec => /video\/H264/i.test(codec.mimeType));
                const fallback = codecs.filter(codec => !/video\/H264/i.test(codec.mimeType));
                if (preferred.length && transceiver.setCodecPreferences) {
                    transceiver.setCodecPreferences([...preferred, ...fallback]);
                }
            } catch (e) { }
        }

        function connectStreamWebSocket() {
            return new Promise((resolve) => {
                if (streamWs && streamWs.readyState === WebSocket.OPEN) {
                    resolve();
                    return;
                }
                if (streamWs) {
                    try { streamWs.close(); } catch (e) { }
                    streamWs = null;
                }

                const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                const wsUrl = `${protocol}//${window.location.host}/stream-ws?key=${encodeURIComponent(currentStreamKey)}`;
                streamWs = new WebSocket(wsUrl);

                streamWs.onopen = () => {
                    console.log('⚡ WebSocket Signaling Connected for [' + currentStreamKey + ']');
                    resolve();
                };

                streamWs.onerror = (err) => {
                    console.warn('WebSocket signaling error:', err);
                    resolve();
                };

                streamWs.onmessage = async (event) => {
                    try {
                        const msg = JSON.parse(event.data);
                        if (msg.type === 'WEBRTC_ANSWER') {
                            if (peerConnection) {
                                await peerConnection.setRemoteDescription(new RTCSessionDescription({ type: 'answer', sdp: msg.sdp }));
                                console.log('⚡ WebRTC Answer set successfully!');
                            }
                        } else if (msg.type === 'WEBRTC_ICE_CANDIDATE') {
                            if (peerConnection && msg.candidate) {
                                await peerConnection.addIceCandidate(new RTCIceCandidate(msg.candidate));
                            }
                        }
                    } catch (e) { }
                };

                streamWs.onclose = () => {
                    console.warn('WebSocket closed');
                    if (mediaStream) {
                        setTimeout(connectStreamWebSocket, 1000);
                    }
                };

                setTimeout(resolve, 3000);
            });
        }

        // Status WS: update basic host UI
        function connectHostStatusWebSocket() {
            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsUrl = `${protocol}//${window.location.host}/status-ws?key=${encodeURIComponent(currentStreamKey)}`;
            const statusWs = new WebSocket(wsUrl);

            statusWs.onmessage = (event) => {
                try {
                    const data = JSON.parse(event.data);
                    if (data.type === 'STATUS') {
                        if (topStatusBox) topStatusBox.style.display = data.live ? 'flex' : 'none';
                    }
                } catch (e) { }
            };

            statusWs.onclose = () => setTimeout(connectHostStatusWebSocket, 3000);
        }
        connectHostStatusWebSocket();

        function updateConnBadge(status, color) {
            if (connDot) connDot.style.background = color;
            if (connText) connText.textContent = status;
            const badge = document.getElementById('topConnBadge');
            if (badge) {
                badge.style.background = color === '#10b981' ? '#072f18' :
                    color === '#f59e0b' ? '#2f2207' : '#2f0707';
                badge.style.color = color === '#10b981' ? '#9fe6c4' :
                    color === '#f59e0b' ? '#f5c490' : '#f59090';
            }
        }

        function startConnMonitor() {
            updateConnBadge('Connecting WebRTC...', '#f59e0b');
        }

        function stopConnMonitor() {
            updateConnBadge('Offline', '#6b7280');
        }

        function showStreamLoader(title, subtitle) {
            const modal = document.getElementById('streamLoaderModal');
            if (title) document.getElementById('loaderTitle').textContent = title;
            if (subtitle) document.getElementById('loaderSubtitle').textContent = subtitle;
            modal.style.display = 'flex';
        }

        function hideStreamLoader() {
            const modal = document.getElementById('streamLoaderModal');
            modal.style.display = 'none';
        }

        let keepAliveAudioCtx = null;
        function enableBackgroundKeepAlive() {
            try {
                if (!keepAliveAudioCtx) {
                    keepAliveAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = keepAliveAudioCtx.createOscillator();
                    const gain = keepAliveAudioCtx.createGain();
                    gain.gain.value = 0.0001;
                    osc.connect(gain);
                    gain.connect(keepAliveAudioCtx.destination);
                    osc.start();
                }
                if (keepAliveAudioCtx.state === 'suspended') {
                    keepAliveAudioCtx.resume();
                }
            } catch (e) { }
        }

        async function startWebRtcSession() {
            if (peerConnection) {
                try { peerConnection.close(); } catch (e) { }
                peerConnection = null;
            }

            peerConnection = new RTCPeerConnection({
                iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
            });

            peerConnection.onicecandidate = (event) => {
                if (event.candidate && streamWs && streamWs.readyState === WebSocket.OPEN) {
                    streamWs.send(JSON.stringify({
                        type: 'WEBRTC_ICE_CANDIDATE',
                        candidate: event.candidate
                    }));
                }
            };

            peerConnection.oniceconnectionstatechange = () => {
                console.log(`[WebRTC State] ${peerConnection.iceConnectionState}`);
                if (peerConnection.iceConnectionState === 'connected' || peerConnection.iceConnectionState === 'completed') {
                    updateConnBadge('Stable 720p WebRTC', '#10b981');
                } else if (peerConnection.iceConnectionState === 'failed') {
                    updateConnBadge('WebRTC Reconnecting', '#ef4444');
                }
            };

            if (mediaStream) {
                mediaStream.getTracks().forEach(track => {
                    const sender = peerConnection.addTrack(track, mediaStream);
                    if (track.kind === 'video') {
                        const transceiver = peerConnection.getTransceivers().find(t => t.sender === sender);
                        preferVideoCodec(transceiver);
                    }
                });
            }

            const senders = peerConnection.getSenders();
            const videoSender = senders.find(s => s.track && s.track.kind === 'video');
            if (videoSender) {
                try {
                    const params = videoSender.getParameters();
                    if (!params.encodings) params.encodings = [{}];
                    params.encodings[0].maxBitrate = STREAM_TARGET.bitrate;
                    params.encodings[0].maxFramerate = STREAM_TARGET.fps;
                    params.encodings[0].priority = 'high';
                    params.encodings[0].networkPriority = 'high';
                    await videoSender.setParameters(params);
                } catch (e) { console.warn('setParameters error', e); }
            }

            const audioSender = senders.find(s => s.track && s.track.kind === 'audio');
            if (audioSender) {
                try {
                    const params = audioSender.getParameters();
                    if (!params.encodings) params.encodings = [{}];
                    params.encodings[0].maxBitrate = 256000;
                    params.encodings[0].priority = 'high';
                    params.encodings[0].networkPriority = 'high';
                    await audioSender.setParameters(params);
                } catch (e) { console.warn('Audio setParameters error', e); }
            }

            const offer = await peerConnection.createOffer({
                offerToReceiveAudio: false,
                offerToReceiveVideo: false
            });

            let sdp = offer.sdp;
            if (!sdp.includes('b=AS:')) {
                sdp = sdp.replace(/(m=video [^\r\n]+\r\n)/, `$1b=AS:${streamBitrate}\r\nb=TIAS:${STREAM_TARGET.bitrate}\r\n`);
            }
            await peerConnection.setLocalDescription({ type: 'offer', sdp });

            if (streamWs && streamWs.readyState === WebSocket.OPEN) {
                streamWs.send(JSON.stringify({
                    type: 'WEBRTC_OFFER',
                    sdp: peerConnection.localDescription.sdp
                }));
            }
        }

        async function startSharing() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia) {
                alert("Screen Sharing requires HTTPS or localhost.");
                return;
            }

            try {
                enableBackgroundKeepAlive();
                const constraints = {
                    video: {
                        width: { ideal: STREAM_TARGET.width, max: STREAM_TARGET.width },
                        height: { ideal: STREAM_TARGET.height, max: STREAM_TARGET.height },
                        frameRate: { ideal: STREAM_TARGET.fps, max: STREAM_TARGET.fps },
                        resizeMode: 'crop-and-scale'
                    },
                    audio: {
                        echoCancellation: false,
                        noiseSuppression: false,
                        autoGainControl: false,
                        channelCount: 2,
                        sampleRate: 48000
                    }
                };

                mediaStream = await navigator.mediaDevices.getDisplayMedia(constraints);

                showStreamLoader("Preparing Live Stream Engine...", "Initializing 720p30 WebRTC relay...");

                await fetch('/reset-stream/' + currentStreamKey, { method: 'POST' });
                startConnMonitor();

                await connectStreamWebSocket();
                await startWebRtcSession();

                previewVideo.srcObject = mediaStream;
                previewVideo.classList.add('active');
                placeholder.style.display = 'none';
                if (topStatusBox) topStatusBox.style.display = 'flex';

                const videoTrack = mediaStream.getVideoTracks()[0];
                if (videoTrack) {
                    const trackSettings = videoTrack.getSettings();
                    console.log(`[Capture] Resolution: ${trackSettings.width}x${trackSettings.height} @ ${trackSettings.frameRate}fps`);
                    if (topQualityBadge) topQualityBadge.textContent = `720p 30FPS WebRTC`;

                    videoTrack.addEventListener('ended', () => {
                        if (!isPageUnloading && document.visibilityState !== 'hidden') stopSharing();
                    });
                }

                toggleShareBtn.classList.remove('start');
                toggleShareBtn.classList.add('stop');
                btnText.textContent = 'Stop Sharing';

                previewVideo.play();
                hideStreamLoader();
            } catch (err) {
                console.error("Error accessing screen share:", err);
                hideStreamLoader();
            }
        }

        function stopSharing() {
            if (isPageUnloading || document.visibilityState === 'hidden') return;

            if (peerConnection) {
                try { peerConnection.close(); } catch (e) { }
                peerConnection = null;
            }

            if (mediaStream) {
                mediaStream.getTracks().forEach(track => track.stop());
                mediaStream = null;
            }

            if (streamWs) {
                try { streamWs.close(); } catch (e) { }
                streamWs = null;
            }

            fetch('/stop-stream/' + currentStreamKey, { method: 'POST' }).catch(err => console.warn('Error calling /stop-stream:', err));

            previewVideo.srcObject = null;
            previewVideo.classList.remove('active');
            placeholder.style.display = 'flex';
            if (topStatusBox) topStatusBox.style.display = 'none';
            stopConnMonitor();

            toggleShareBtn.classList.remove('stop');
            toggleShareBtn.classList.add('start');
            btnText.textContent = 'Share Screen';
        }

        // Controls
        muteBtn.addEventListener('click', () => {
            previewVideo.muted = !previewVideo.muted;
            if (previewVideo.muted) {
                unmutedIcon.style.display = 'none';
                mutedIcon.style.display = 'block';
            } else {
                unmutedIcon.style.display = 'block';
                mutedIcon.style.display = 'none';
            }
        });

        fullscreenBtn.addEventListener('click', () => {
            if (!document.fullscreenElement) {
                playerWrapper.requestFullscreen().catch(err => console.error(err));
            } else {
                document.exitFullscreen();
            }
        });

        // Copy live preview link to clipboard when watch/copy button is pressed
        const watchLiveBtnEl = document.getElementById('watchLiveBtn');
        function showCopyToast(text) {
            let toast = document.getElementById('copyToast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'copyToast';
                toast.style.position = 'fixed';
                toast.style.bottom = '96px';
                toast.style.left = '50%';
                toast.style.transform = 'translateX(-50%)';
                toast.style.background = 'rgba(0,0,0,0.8)';
                toast.style.color = '#fff';
                toast.style.padding = '8px 12px';
                toast.style.borderRadius = '8px';
                toast.style.zIndex = '10000';
                toast.style.fontSize = '0.9rem';
                toast.style.boxShadow = '0 6px 18px rgba(0,0,0,0.5)';
                document.body.appendChild(toast);
            }
            toast.textContent = text;
            toast.style.opacity = '1';
            toast.style.transition = 'opacity 0.25s ease';
            setTimeout(() => {
                toast.style.opacity = '0';
            }, 1800);
        }

        if (watchLiveBtnEl) {
            watchLiveBtnEl.addEventListener('click', async (e) => {
                e.preventDefault();
                const url = `${window.location.protocol}//${window.location.host}/live/${encodeURIComponent(currentStreamKey)}`;
                try {
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        await navigator.clipboard.writeText(url);
                        showCopyToast('Stream link copied to clipboard');
                    } else {
                        // Fallback copy
                        const ta = document.createElement('textarea');
                        ta.value = url;
                        ta.style.position = 'fixed';
                        ta.style.opacity = '0';
                        document.body.appendChild(ta);
                        ta.select();
                        document.execCommand('copy');
                        document.body.removeChild(ta);
                        showCopyToast('Stream link copied to clipboard');
                    }
                    // small visual feedback: flash the button
                    watchLiveBtnEl.style.transform = 'scale(0.95)';
                    setTimeout(() => watchLiveBtnEl.style.transform = '', 150);
                } catch (err) {
                    console.warn('Copy failed', err);
                    showCopyToast('Unable to copy link');
                }
            });
        }
    </script>
</body>

</html>
