<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoWatch Live - Multi-Stream Cloud Platform</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/output.css">
    <style>
        body {
            background-color: #0B0909;
            background-image: 
                radial-gradient(at 0% 0%, rgba(255, 158, 32, 0.12) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(255, 158, 32, 0.08) 0px, transparent 50%);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        .glass-card {
            background: rgba(29, 33, 40, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .glass-card:hover {
            border-color: rgba(255, 158, 32, 0.4);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 158, 32, 0.15);
        }

        .gradient-text {
            background: linear-gradient(135deg, #FF9E20 0%, #FFD580 100%);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .glow-btn {
            background: linear-gradient(135deg, #FF9E20 0%, #E88D1A 100%);
            box-shadow: 0 4px 20px rgba(255, 158, 32, 0.4);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .glow-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 158, 32, 0.6);
        }

        .glow-btn:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px rgba(255, 158, 32, 0.5);
        }

        @media (prefers-reduced-motion: reduce) {
            .glow-btn { transition: none; }
            .glow-btn:hover { transform: none; }
            .animate-ping { animation: none !important; }
        }
    </style>
</head>
<body class="min-h-screen text-slate-100 flex flex-col justify-between antialiased">

    <!-- Header Navigation -->
    <header class="w-full border-b border-white/10 bg-slate-950/60 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-amber-600/20 border border-amber-500/30 flex items-center justify-center text-amber-400 text-xl font-bold group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-play" aria-hidden="true"></i>
                </div>
                <div>
                    <span class="text-xl font-bold text-white tracking-tight">CoWatch <span class="gradient-text">Studio</span></span>
                    <span class="block text-[10px] text-amber-400 font-mono tracking-wider uppercase">Multi-Stream Engine</span>
                </div>
            </a>

            <div class="flex items-center gap-3">
                <% if (typeof user !== 'undefined' && user) { %>
                    <span class="text-xs font-mono text-slate-300 bg-slate-900 px-3 py-2 rounded-xl border border-white/10 hidden sm:inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-layer-group text-amber-400" aria-hidden="true"></i>
                        <span>Quota: <strong><%= user.streamCount %></strong> / <strong><%= user.streamLimit %></strong></span>
                    </span>
                    <% if (user.role === 'admin') { %>
                        <a href="/admin" class="px-4 py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 text-xs font-semibold transition-colors flex items-center gap-1.5">
                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                            <span>Admin</span>
                        </a>
                    <% } %>
                    <a href="/logout" aria-label="Log out" class="px-3.5 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 text-xs font-semibold transition-colors flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                    </a>
                <% } %>
                <button onclick="openCreateModal()" class="glow-btn px-5 py-2.5 rounded-xl text-sm font-semibold text-white flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400">
                    <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>
                    <span>Create Stream</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 w-full">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-4">
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping" aria-hidden="true"></span>
                Direct Multi-Stream Ingest
            </div>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 leading-tight" style="text-wrap:balance">
                Stream Movies & Games in <span class="gradient-text">Real-Time HLS</span>
            </h1>
            <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
                    Launch unique stream channels instantly with 720p WebRTC passthrough streaming and persistent connection.
            </p>
        </div>

        <!-- Active Streams List Header -->
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-tower-broadcast text-amber-400 text-base" aria-hidden="true"></i>
                <span>Active Live Streams</span>
            </h2>
            <span class="text-xs font-mono text-slate-400 bg-slate-800/80 px-3 py-1 rounded-full border border-white/10" id="streamCountBadge" style="font-variant-numeric:tabular-nums">
                <%= streams.length %> Channels
            </span>
        </div>

        <!-- Streams Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="streamsGrid">
            <% if (streams.length === 0) { %>
                <!-- Empty State -->
                <div class="col-span-full glass-card rounded-2xl p-12 text-center border border-dashed border-slate-700">
                    <div class="w-16 h-16 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 text-2xl mx-auto mb-4">
                        <i class="fa-solid fa-video-slash" aria-hidden="true"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-1">No Active Streams Found</h3>
                    <p class="text-slate-400 text-sm max-w-md mx-auto mb-6">
                        Create your first streaming channel to start broadcasting live screen video to ExCloud CDN.
                    </p>
                    <button onclick="openCreateModal()" class="glow-btn px-6 py-2.5 rounded-xl text-sm font-semibold text-white inline-flex items-center gap-2">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        <span>Create First Stream</span>
                    </button>
                </div>
            <% } else { %>
                <% streams.forEach(function(item) { %>
                    <div class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="px-2.5 py-1 rounded-full text-xs font-mono font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                                    Key: <%= item.streamKey %>
                                </span>
                                <% if (item.isLive) { %>
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-red-500/20 text-red-400 border border-red-500/30 flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping" aria-hidden="true"></span>
                                        LIVE
                                    </span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-800 text-slate-400 border border-slate-700">
                                        Offline
                                    </span>
                                <% } %>
                            </div>
                            <h3 class="text-lg font-bold text-white mb-2 line-clamp-1"><%= item.title %></h3>
                            <p class="text-xs text-slate-400 font-mono mb-6 truncate">
                                CDN: https://1834.objects.excloud.dev/public/live/<%= item.streamKey %>/master.m3u8
                            </p>
                        </div>

                        <div class="flex items-center gap-2 pt-4 border-t border-white/10">
                            <a href="/stream/<%= item.streamKey %>" class="flex-1 text-center py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white transition-colors border border-white/10 flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-sliders text-amber-400" aria-hidden="true"></i>
                                <span>Studio</span>
                            </a>
                            <a href="/live/<%= item.streamKey %>" target="_blank" class="flex-1 text-center py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-xs font-semibold text-white transition-all shadow-md flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-play" aria-hidden="true"></i>
                                <span>Watch Live</span>
                            </a>
                            <button data-streamkey="<%= item.streamKey %>" onclick="deleteStream(this.dataset.streamkey)" aria-label="Delete stream <%= item.streamKey %>" class="px-3 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 text-xs font-semibold transition-colors flex items-center justify-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400" title="Delete Stream">
                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </main>

    <!-- Create Stream Modal -->
    <div id="createModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4 transition-all opacity-0 pointer-events-none">
        <div class="glass-card rounded-2xl p-6 sm:p-8 max-w-md w-full border border-white/15 shadow-2xl relative">
            <button onclick="closeCreateModal()" aria-label="Close modal" class="absolute top-5 right-5 text-slate-400 hover:text-white text-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>

            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-amber-600/20 border border-amber-500/30 flex items-center justify-center text-amber-400 text-lg">
                    <i class="fa-solid fa-headset" aria-hidden="true"></i>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">Create Live Channel</h3>
                    <p class="text-xs text-slate-400">Launch a new isolated streaming key</p>
                </div>
            </div>

            <form onsubmit="handleCreateStream(event)" class="space-y-5">
                <div>
                    <label for="streamTitle" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Stream Title</label>
                    <input type="text" id="streamTitle" name="title" required placeholder="e.g. Inception 1080p Movie Night…" autocomplete="off" class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-white/10 text-white text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus:border-amber-500">
                </div>

                <div>
                    <label for="streamKeyPreview" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Generated Stream Key</label>
                    <input type="text" id="streamKeyPreview" name="streamKey" readonly class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-white/10 text-amber-300 font-mono text-sm focus-visible:outline-none cursor-not-allowed" style="font-variant-numeric:tabular-nums">
                </div>

                <div class="pt-3 flex gap-3">
                    <button type="button" onclick="closeCreateModal()" class="flex-1 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 py-3 rounded-xl glow-btn text-white text-sm font-semibold transition-all">
                        Launch Channel
                    </button>
                </div>
            </form>
        </div>
    </div>

    <footer class="w-full border-t border-white/10 py-6 text-center text-xs text-slate-500">
        CoWatch Multi-Stream Platform &copy; 2026. High-Performance HLS Architecture.
    </footer>

    <script>
        function generateRandomKey() {
            return 'str_' + Math.random().toString(36).substring(2, 9);
        }

        function openCreateModal() {
            const modal = document.getElementById('createModal');
            document.getElementById('streamKeyPreview').value = generateRandomKey();
            document.getElementById('streamTitle').value = '';
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeCreateModal() {
            const modal = document.getElementById('createModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        async function handleCreateStream(e) {
            e.preventDefault();
            const title = document.getElementById('streamTitle').value.trim();
            const streamKey = document.getElementById('streamKeyPreview').value.trim();

            try {
                const res = await fetch('/api/streams/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, streamKey })
                });

                const data = await res.json();
                if (data.success) {
                    window.location.href = `/stream/${data.streamKey}`;
                } else {
                    alert('Error creating stream: ' + (data.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Network error: ' + err.message);
            }
        }

        async function deleteStream(streamKey) {
            if (!confirm(`Are you sure you want to delete stream [${streamKey}]?`)) {
                return;
            }

            try {
                const res = await fetch(`/api/streams/delete/${encodeURIComponent(streamKey)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Delete failed: ' + (data.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Network error: ' + err.message);
            }
        }
    </script>
</body>
</html>
