<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoWatch Live - Multi-Stream Cloud Platform</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: '#6366f1',
                        'accent-dark': '#4f46e5',
                        'dark-bg': '#090d16',
                        'card-bg': 'rgba(15, 23, 42, 0.75)',
                        'glass-border': 'rgba(255, 255, 255, 0.12)',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #090d16;
            background-image: 
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(139, 92, 246, 0.12) 0px, transparent 50%);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        .glass-card {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .glass-card:hover {
            border-color: rgba(99, 102, 241, 0.4);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(99, 102, 241, 0.2);
        }

        .gradient-text {
            background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .glow-btn {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
            transition: all 0.2s ease;
        }

        .glow-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(99, 102, 241, 0.6);
        }
    </style>
</head>
<body class="min-h-screen text-slate-100 flex flex-col justify-between antialiased">

    <!-- Header Navigation -->
    <header class="w-full border-b border-white/10 bg-slate-950/60 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 text-xl font-bold group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-play"></i>
                </div>
                <div>
                    <span class="text-xl font-bold text-white tracking-tight">CoWatch <span class="gradient-text">Studio</span></span>
                    <span class="block text-[10px] text-indigo-400 font-mono tracking-wider uppercase">Multi-Stream Engine</span>
                </div>
            </a>

            <button onclick="openCreateModal()" class="glow-btn px-5 py-2.5 rounded-xl text-sm font-semibold text-white flex items-center gap-2">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>Create Stream</span>
            </button>
        </div>
    </header>

    <!-- Hero Section -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 w-full">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4">
                <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
                ExCloud S3 Direct Multi-Stream Ingest
            </div>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 leading-tight">
                Stream Movies & Games in <span class="gradient-text">Real-Time Cloud HLS</span>
            </h1>
            <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
                Launch unique stream channels instantly. Video chunks stream directly to ExCloud S3 bucket CDN with dual 720p/480p adaptive bitrates.
            </p>
        </div>

        <!-- Active Streams List Header -->
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-tower-broadcast text-indigo-400 text-base"></i>
                <span>Active Live Streams</span>
            </h2>
            <span class="text-xs font-mono text-slate-400 bg-slate-800/80 px-3 py-1 rounded-full border border-white/10" id="streamCountBadge">
                <%= streams.length %> Channels
            </span>
        </div>

        <!-- Streams Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="streamsGrid">
            <% if (streams.length === 0) { %>
                <!-- Empty State -->
                <div class="col-span-full glass-card rounded-2xl p-12 text-center border border-dashed border-slate-700">
                    <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 text-2xl mx-auto mb-4">
                        <i class="fa-solid fa-video-slash"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-1">No Active Streams Found</h3>
                    <p class="text-slate-400 text-sm max-w-md mx-auto mb-6">
                        Create your first streaming channel to start broadcasting live screen video to ExCloud CDN.
                    </p>
                    <button onclick="openCreateModal()" class="glow-btn px-6 py-2.5 rounded-xl text-sm font-semibold text-white inline-flex items-center gap-2">
                        <i class="fa-solid fa-plus"></i>
                        <span>Create First Stream</span>
                    </button>
                </div>
            <% } else { %>
                <% streams.forEach(function(item) { %>
                    <div class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="px-2.5 py-1 rounded-full text-xs font-mono font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                                    Key: <%= item.streamKey %>
                                </span>
                                <% if (item.isLive) { %>
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-red-500/20 text-red-400 border border-red-500/30 flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span>
                                        LIVE
                                    </span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-800 text-slate-400 border border-slate-700">
                                        Offline
                                    </span>
                                <% } %>
                            </div>
                            <h3 class="text-lg font-bold text-white mb-2 line-clamp-1"><%= item.title %></h3>
                            <p class="text-xs text-slate-400 font-mono mb-6 truncate">
                                CDN: https://1834.objects.excloud.dev/public/live/<%= item.streamKey %>/master.m3u8
                            </p>
                        </div>

                        <div class="flex items-center gap-3 pt-4 border-t border-white/10">
                            <a href="/stream/<%= item.streamKey %>" class="flex-1 text-center py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white transition-colors border border-white/10 flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-sliders text-indigo-400"></i>
                                <span>Studio</span>
                            </a>
                            <a href="/live/<%= item.streamKey %>" target="_blank" class="flex-1 text-center py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-xs font-semibold text-white transition-all shadow-md flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-play"></i>
                                <span>Watch Live</span>
                            </a>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </main>

    <!-- Create Stream Modal -->
    <div id="createModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4 transition-all opacity-0 pointer-events-none">
        <div class="glass-card rounded-2xl p-6 sm:p-8 max-w-md w-full border border-white/15 shadow-2xl relative">
            <button onclick="closeCreateModal()" class="absolute top-5 right-5 text-slate-400 hover:text-white text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 text-lg">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">Create Live Channel</h3>
                    <p class="text-xs text-slate-400">Generate a unique stream key and S3 channel</p>
                </div>
            </div>

            <form id="createStreamForm" onsubmit="handleCreateStream(event)">
                <div class="mb-5">
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Stream Title</label>
                    <input type="text" id="streamTitle" required placeholder="e.g. Movie Stream #1 - Movie Title" class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-white/15 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all">
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Stream Key (Auto-Generated)</label>
                    <input type="text" id="streamKeyPreview" readonly class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-indigo-400 font-mono text-sm focus:outline-none cursor-not-allowed">
                </div>

                <div class="flex items-center justify-end gap-3">
                    <button type="button" onclick="closeCreateModal()" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="glow-btn px-6 py-2.5 rounded-xl text-xs font-semibold text-white flex items-center gap-2">
                        <i class="fa-solid fa-bolt"></i>
                        <span>Launch Studio</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Footer -->
    <footer class="w-full border-t border-white/10 py-6 text-center text-xs text-slate-500">
        CoWatch Multi-Stream Platform &copy; 2026. ExCloud S3 HLS CDN Architecture.
    </footer>

    <script>
        function generateRandomKey() {
            return 'str_' + Math.random().toString(36).substring(2, 9);
        }

        function openCreateModal() {
            const modal = document.getElementById('createModal');
            document.getElementById('streamKeyPreview').value = generateRandomKey();
            document.getElementById('streamTitle').value = '';
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeCreateModal() {
            const modal = document.getElementById('createModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        async function handleCreateStream(e) {
            e.preventDefault();
            const title = document.getElementById('streamTitle').value.trim();
            const streamKey = document.getElementById('streamKeyPreview').value.trim();

            try {
                const res = await fetch('/api/streams/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, streamKey })
                });

                const data = await res.json();
                if (data.success) {
                    window.location.href = `/stream/${data.streamKey}`;
                } else {
                    alert('Error creating stream: ' + (data.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Network error: ' + err.message);
            }
        }
    </script>
</body>
</html>
