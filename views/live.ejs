<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= stream.title %> | Google Meet</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --meet-bg: #202124;
            --meet-stage-bg: #141517;
            --meet-card-bg: #3c4043;
            --meet-card-dark: #28292c;
            --meet-hover: #474b50;
            --meet-primary: #1a73e8;
            --meet-red: #ea4335;
            --meet-green: #188038;
            --meet-text: #e8eaed;
            --meet-subtext: #9aa0a6;
            --meet-border: rgba(255, 255, 255, 0.1);
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        html, body { width:100%; height:100%; overflow:hidden; font-family:'Google Sans', 'Roboto', sans-serif; background:var(--meet-bg); color:var(--meet-text); }

        /* ─── Screens ─── */
        .screen { position:absolute; inset:0; display:none; flex-direction:column; align-items:center; justify-content:center; z-index:100; }
        .screen.active { display:flex; }

        /* ─── Join Screen ─── */
        #join-screen { background:var(--meet-bg); }
        .join-container { display:flex; gap:40px; align-items:center; max-width:960px; width:90%; }
        
        .join-preview { flex:1.2; aspect-ratio:16/9; background:#171717; border-radius:16px; position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center; box-shadow:0 12px 32px rgba(0,0,0,0.5); border:1px solid var(--meet-border); }
        .join-preview-avatar { width:100px; height:100px; border-radius:50%; background:#5f6368; color:#fff; display:flex; align-items:center; justify-content:center; font-size:2.8rem; font-weight:500; }

        .join-form-card { flex:1; display:flex; flex-direction:column; gap:20px; }
        .join-form-card h1 { font-size:1.75rem; font-weight:400; color:#fff; letter-spacing:-0.01em; }
        .join-form-card p { color:var(--meet-subtext); font-size:0.95rem; }
        .join-input { width:100%; padding:16px 20px; border-radius:8px; border:1px solid #5f6368; background:#28292c; color:#fff; font-size:1rem; outline:none; transition:border-color 0.2s; }
        .join-input:focus { border-color:var(--meet-primary); }
        .join-action-btn { padding:14px 28px; border-radius:24px; border:none; background:var(--meet-primary); color:#fff; font-weight:500; font-size:0.95rem; cursor:pointer; transition:all 0.2s; display:inline-flex; align-items:center; justify-content:center; gap:8px; width:fit-content; box-shadow:0 4px 12px rgba(26,115,232,0.3); }
        .join-action-btn:hover { background:#1557b0; transform:translateY(-1px); }
        .join-action-btn:disabled { opacity:0.5; cursor:not-allowed; transform:none; }
        .join-error { color:var(--meet-red); font-size:0.85rem; min-height:20px; }

        /* ─── Waiting & Kicked Screens ─── */
        #waiting-screen, #kicked-screen { background:var(--meet-bg); text-align:center; }
        .waiting-box { display:flex; flex-direction:column; align-items:center; gap:16px; max-width:420px; }
        .waiting-spinner { width:48px; height:48px; border:4px solid rgba(255,255,255,0.1); border-top-color:var(--meet-primary); border-radius:50%; animation:spin 0.8s linear infinite; }
        @keyframes spin { to { transform:rotate(360deg); } }

        /* ─── Main Meeting Interface ─── */
        #main-screen { width:100%; height:100vh; background:var(--meet-stage-bg); flex-direction:column; position:relative; overflow:hidden; }

        /* Top Meeting Header */
        .meet-top-bar { position:absolute; top:0; left:0; right:0; height:56px; display:flex; align-items:center; justify-content:space-between; padding:0 24px; z-index:30; background:linear-gradient(to bottom, rgba(20,21,23,0.95), transparent); pointer-events:none; }
        .meet-top-bar > * { pointer-events:auto; }
        .meet-room-info { display:flex; align-items:center; gap:12px; }
        .meet-title { font-size:1rem; font-weight:500; color:#fff; }
        .meet-badge { padding:4px 10px; border-radius:12px; font-size:0.75rem; font-weight:500; background:rgba(255,255,255,0.08); color:var(--meet-subtext); display:inline-flex; align-items:center; gap:6px; }
        .meet-badge.live { background:rgba(24,128,56,0.2); color:#81c995; }
        .meet-badge-dot { width:6px; height:6px; border-radius:50%; background:#34a853; }

        /* Main Stage Area */
        .meet-stage { flex:1; width:100%; height:calc(100vh - 76px); display:flex; flex-direction:row; gap:16px; position:relative; overflow:hidden; padding:64px 16px 16px 16px; align-items:center; justify-content:center; }

        /* Adaptive Grid View (Normal Talking Mode) */
        .meet-grid { flex:1; min-width:0; height:100%; display:grid; gap:16px; align-content:center; justify-content:center; max-width:1400px; margin:0 auto; transition:all 0.3s ease; }
        
        .meet-card { background:var(--meet-card-dark); border-radius:16px; position:relative; overflow:hidden; display:flex; flex-direction:column; align-items:center; justify-content:center; transition:all 0.25s ease; border:2px solid transparent; box-shadow:0 4px 20px rgba(0,0,0,0.4); width:100%; height:100%; min-height:0; }
        .meet-card.speaking { border-color:#1a73e8; box-shadow:0 0 20px rgba(26,115,232,0.4); }
        .meet-avatar { width:96px; height:96px; border-radius:50%; background:#5f6368; color:#fff; display:flex; align-items:center; justify-content:center; font-size:2.4rem; font-weight:500; box-shadow:0 4px 16px rgba(0,0,0,0.3); }
        
        .meet-name-tag { position:absolute; bottom:12px; left:12px; background:rgba(32,33,36,0.85); backdrop-filter:blur(8px); padding:4px 12px; border-radius:6px; font-size:0.82rem; font-weight:500; color:#fff; display:flex; align-items:center; gap:8px; }
        .meet-card-mic { position:absolute; top:12px; right:12px; width:28px; height:28px; border-radius:50%; background:rgba(32,33,36,0.85); backdrop-filter:blur(8px); display:flex; align-items:center; justify-content:center; font-size:0.75rem; color:#fff; }
        .meet-card-mic.off { background:var(--meet-red); color:#fff; }

        /* Video Container (Screen Share Mode) - FULL STAGE */
        .meet-video-container { flex:1; min-width:0; height:100%; display:none; position:relative; background:#000; border-radius:16px; overflow:hidden; border:1px solid var(--meet-border); align-items:center; justify-content:center; transition:all 0.3s ease; }
        .meet-video-container.active { display:flex; }
        #host-video { width:100%; height:100%; object-fit:contain; }

        /* Fullscreen Mode Overrides */
        :fullscreen .meet-top-bar, :-webkit-full-screen .meet-top-bar { display: none !important; }
        :fullscreen .meet-stage, :-webkit-full-screen .meet-stage { padding: 0 !important; height: 100vh !important; width: 100vw !important; }
        :fullscreen .meet-video-container, :-webkit-full-screen .meet-video-container { border-radius: 0 !important; border: none !important; width: 100vw !important; height: 100vh !important; }
        :fullscreen #host-video, :-webkit-full-screen #host-video { width: 100vw !important; height: 100vh !important; object-fit: contain !important; }

        /* Bottom Control Dock */
        .meet-dock-wrapper { position:absolute; bottom:16px; left:50%; transform:translateX(-50%); z-index:40; }
        .meet-dock { background:#202124; border:1px solid rgba(255,255,255,0.08); padding:8px 16px; border-radius:36px; display:flex; align-items:center; gap:12px; box-shadow:0 8px 28px rgba(0,0,0,0.6); }
        
        .dock-btn { width:44px; height:44px; border-radius:50%; border:none; background:#3c4043; color:#e8eaed; font-size:1.15rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.2s cubic-bezier(0.4,0,0.2,1); position:relative; }
        .dock-btn:hover { background:#474b50; transform:scale(1.05); }
        .dock-btn.active { background:var(--meet-primary); color:#fff; }
        .dock-btn.off { background:var(--meet-red); color:#fff; }
        .dock-btn:disabled { opacity:0.4; cursor:not-allowed; transform:none; }
        
        .dock-divider { width:1px; height:24px; background:rgba(255,255,255,0.18); margin:0 2px; }
        .dock-end-btn { width:64px; height:44px; border-radius:22px; border:none; background:var(--meet-red); color:#fff; font-size:1.15rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.2s; }
        .dock-end-btn:hover { background:#dc2626; transform:scale(1.05); }

        /* Settings Menu Popup */
        .settings-menu { position:absolute; bottom:70px; left:50%; transform:translateX(-50%); background:#28292c; border:1px solid var(--meet-border); border-radius:12px; padding:12px; width:280px; box-shadow:0 12px 32px rgba(0,0,0,0.6); display:none; flex-direction:column; gap:8px; z-index:50; }
        .settings-menu.active { display:flex; }
        .settings-header { font-size:0.85rem; font-weight:500; color:var(--meet-subtext); margin-bottom:4px; }
        .device-select { width:100%; padding:8px 12px; border-radius:6px; border:1px solid #5f6368; background:#202124; color:#fff; font-size:0.85rem; outline:none; }

        /* Sidebar Drawer */
        .meet-sidebar { position:relative; width:360px; height:100%; flex-shrink:0; background:#202124; border-radius:16px; border:1px solid var(--meet-border); z-index:35; display:none; flex-direction:column; overflow:hidden; box-shadow:0 12px 36px rgba(0,0,0,0.6); }
        .meet-sidebar.active { display:flex; }

        .sidebar-header { padding:16px 20px; border-bottom:1px solid var(--meet-border); display:flex; align-items:center; justify-content:space-between; }
        .sidebar-header h3 { font-size:1.1rem; font-weight:500; }
        .sidebar-close-btn { background:none; border:none; color:var(--meet-subtext); font-size:1.1rem; cursor:pointer; padding:4px; }

        .sidebar-tabs { display:flex; border-bottom:1px solid var(--meet-border); }
        .tab-btn { flex:1; padding:12px; border:none; background:transparent; color:var(--meet-subtext); font-size:0.88rem; font-weight:500; cursor:pointer; border-bottom:2px solid transparent; }
        .tab-btn.active { color:var(--meet-primary); border-bottom-color:var(--meet-primary); }

        .sidebar-body { flex:1; display:none; flex-direction:column; overflow:hidden; }
        .sidebar-body.active { display:flex; }

        /* Modern Google Meet Chat Message UI */
        .chat-list { flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:16px; }
        .chat-item { display:flex; flex-direction:column; gap:4px; max-width:88%; width:fit-content; }
        .chat-item.own { align-self:flex-end; }
        .chat-header { display:flex; align-items:center; gap:8px; font-size:0.78rem; color:var(--meet-subtext); }
        .chat-header .author { font-weight:500; color:#fff; }
        .chat-bubble { font-size:0.9rem; color:#fff; background:#28292c; padding:10px 14px; border-radius:12px; line-height:1.45; word-break:break-word; border:1px solid var(--meet-border); }
        .chat-item.own .chat-bubble { background:var(--meet-primary); border-color:var(--meet-primary); }
        
        .chat-form { padding:12px 16px; border-top:1px solid var(--meet-border); display:flex; gap:8px; }
        .chat-input { flex:1; padding:10px 16px; border-radius:20px; border:1px solid #5f6368; background:#28292c; color:#fff; font-size:0.9rem; outline:none; }
        .chat-send-btn { width:38px; height:38px; border-radius:50%; border:none; background:var(--meet-primary); color:#fff; cursor:pointer; display:flex; align-items:center; justify-content:center; }

        .people-list { flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:10px; }
        .person-row { display:flex; flex-direction:row; align-items:center; justify-content:space-between; gap:12px; padding:10px 14px; border-radius:12px; background:#28292c; width:100%; border:1px solid var(--meet-border); }
        .person-info-group { display:flex; align-items:center; gap:12px; flex:1; min-width:0; }
        .person-avatar { width:38px; height:38px; border-radius:50%; background:#5f6368; color:#fff; display:flex; align-items:center; justify-content:center; font-size:0.95rem; font-weight:500; flex-shrink:0; }
        .person-name { font-size:0.9rem; font-weight:500; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

        .toast-box { position:fixed; bottom:80px; left:24px; z-index:200; display:flex; flex-direction:column; gap:8px; }
        .meet-toast { padding:12px 20px; border-radius:8px; background:#323232; color:#fff; font-size:0.88rem; box-shadow:0 4px 14px rgba(0,0,0,0.5); }
    </style>
</head>
<body>

    <audio id="host-audio" autoplay></audio>

    <!-- ═══ PRE-JOIN PREVIEW SCREEN ═══ -->
    <div id="join-screen" class="screen active">
        <div class="join-container">
            <div class="join-preview">
                <div class="join-preview-avatar" id="preview-avatar-icon">U</div>
            </div>
            <div class="join-form-card">
                <h1>Ready to join?</h1>
                <p>Enter your name to request access to <strong><%= stream.title %></strong></p>
                <input id="join-name" class="join-input" type="text" placeholder="Your name" maxlength="30" autocomplete="off" autofocus>
                <button id="join-btn" class="join-action-btn"><i class="fa-solid fa-video" style="margin-right:4px;"></i>Ask to join</button>
                <div id="join-error" class="join-error"></div>
            </div>
        </div>
    </div>

    <!-- ═══ WAITING FOR HOST SCREEN ═══ -->
    <div id="waiting-screen" class="screen">
        <div class="waiting-box">
            <div class="waiting-spinner"></div>
            <h2 style="font-size:1.4rem; font-weight:400;">Asking to join...</h2>
            <p style="color:var(--meet-subtext); font-size:0.9rem;">You'll join the call once the host approves your request.</p>
        </div>
    </div>

    <!-- ═══ KICKED SCREEN ═══ -->
    <div id="kicked-screen" class="screen">
        <div class="waiting-box">
            <i class="fa-solid fa-circle-exclamation" style="font-size:3rem; color:var(--meet-red);"></i>
            <h2 style="font-size:1.4rem; font-weight:400;">You left the meeting</h2>
            <p style="color:var(--meet-subtext); font-size:0.9rem;" id="kicked-reason">Removed by host</p>
        </div>
    </div>

    <!-- ═══ MAIN GOOGLE MEET INTERFACE ═══ -->
    <div id="main-screen" class="screen">
        <!-- Top Header Bar -->
        <div class="meet-top-bar">
            <div class="meet-room-info">
                <span class="meet-title"><%= stream.title %></span>
                <span id="meeting-mode-badge" class="meet-badge"><span class="meet-badge-dot"></span><span id="mode-text">Voice Call</span></span>
            </div>
            <div class="meet-room-info">
                <span id="time-clock" style="font-size:0.88rem; color:var(--meet-subtext);"></span>
            </div>
        </div>

        <!-- Main Stage Container -->
        <div class="meet-stage">
            <!-- Adaptive Grid View (Normal Talking Mode) -->
            <div id="meet-grid" class="meet-grid"></div>

            <!-- Video Player (Screen Share Mode) - FULL STAGE -->
            <div id="meet-video-container" class="meet-video-container">
                <video id="host-video" autoplay playsinline></video>
            </div>

            <!-- Google Meet Sidebar -->
            <div id="meet-sidebar" class="meet-sidebar">
                <div class="sidebar-header">
                    <h3 id="sidebar-title">In-call messages</h3>
                    <button id="sidebar-close" class="sidebar-close-btn"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="sidebar-tabs">
                    <button id="tab-chat-btn" class="tab-btn active">Chat</button>
                    <button id="tab-people-btn" class="tab-btn">People (<span id="people-count">0</span>)</button>
                </div>

                <!-- Chat Body -->
                <div id="body-chat" class="sidebar-body active">
                    <div id="chat-list" class="chat-list"></div>
                    <div class="chat-form">
                        <input id="chat-input" class="chat-input" type="text" placeholder="Send a message" maxlength="500" autocomplete="off">
                        <button id="chat-send" class="chat-send-btn"><i class="fa-solid fa-paper-plane"></i></button>
                    </div>
                </div>

                <!-- People Body -->
                <div id="body-people" class="sidebar-body">
                    <div id="people-list" class="people-list"></div>
                </div>
            </div>
        </div>

        <!-- Floating Google Meet Bottom Control Dock -->
        <div class="meet-dock-wrapper">
            <div class="meet-dock">
                <button id="dock-mic-btn" class="dock-btn off" title="Toggle mic" disabled><i class="fa-solid fa-microphone-slash"></i></button>
                <button id="dock-settings-btn" class="dock-btn" title="Microphone settings"><i class="fa-solid fa-gear"></i></button>
                <button id="dock-fullscreen-btn" class="dock-btn" title="Toggle full screen"><i class="fa-solid fa-expand"></i></button>
                <button id="dock-chat-btn" class="dock-btn" title="Chat"><i class="fa-solid fa-message"></i></button>
                <button id="dock-people-btn" class="dock-btn" title="People"><i class="fa-solid fa-users"></i></button>
                <div class="dock-divider"></div>
                <button id="dock-end-btn" class="dock-end-btn" title="Leave call"><i class="fa-solid fa-phone-slash"></i></button>
            </div>

            <!-- Settings Menu Popup -->
            <div id="settings-menu" class="settings-menu">
                <div class="settings-header"><i class="fa-solid fa-microphone" style="margin-right:6px;"></i>Microphone Device</div>
                <select id="mic-device-select" class="device-select"></select>
            </div>
        </div>

        <div id="toasts" class="toast-box"></div>
    </div>

    <script>
    (function() {
        const streamKey = '<%= streamKey %>';
        const streamTitle = '<%= stream.title %>';

        // ─── State Variables ───
        let myName = '';
        let myParticipantId = null;
        let statusWs = null;
        let pc = null;
        let remoteStream = null;
        let isLive = false;
        let isScreenSharing = false;
        let canTalk = false;
        let micEnabled = false;
        let micStream = null;
        let selectedMicId = '';
        let audioCtx = null;
        let activeTab = 'chat';
        let sidebarOpen = false;
        let settingsOpen = false;
        let participants = [];

        // ─── DOM References ───
        const $ = id => document.getElementById(id);
        const screens = { join: $('join-screen'), waiting: $('waiting-screen'), kicked: $('kicked-screen'), main: $('main-screen') };
        const joinName = $('join-name'), joinBtn = $('join-btn'), joinError = $('join-error'), previewAvatarIcon = $('preview-avatar-icon');
        const hostVideo = $('host-video'), hostAudio = $('host-audio'), meetGrid = $('meet-grid'), meetVideoContainer = $('meet-video-container');
        const dockMicBtn = $('dock-mic-btn'), dockSettingsBtn = $('dock-settings-btn'), dockFullscreenBtn = $('dock-fullscreen-btn');
        const dockChatBtn = $('dock-chat-btn'), dockPeopleBtn = $('dock-people-btn'), dockEndBtn = $('dock-end-btn');
        const settingsMenu = $('settings-menu'), micDeviceSelect = $('mic-device-select');
        const meetSidebar = $('meet-sidebar'), sidebarClose = $('sidebar-close');
        const tabChatBtn = $('tab-chat-btn'), tabPeopleBtn = $('tab-people-btn');
        const bodyChat = $('body-chat'), bodyPeople = $('body-people');
        const chatList = $('chat-list'), chatInput = $('chat-input'), chatSend = $('chat-send');
        const peopleList = $('people-list'), peopleCount = $('people-count');
        const modeText = $('mode-text'), timeClock = $('time-clock'), toasts = $('toasts');

        function updateClock() {
            const now = new Date();
            timeClock.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
        setInterval(updateClock, 1000);
        updateClock();

        joinName.addEventListener('input', () => {
            const val = joinName.value.trim();
            previewAvatarIcon.textContent = (val || 'U').charAt(0).toUpperCase();
        });

        function showScreen(name) {
            Object.values(screens).forEach(s => s.classList.remove('active'));
            screens[name].classList.add('active');
            if (name === 'main') {
                setTimeout(() => startWebRtcViewer(), 200);
            }
        }

        function toast(text) {
            const t = document.createElement('div');
            t.className = 'meet-toast';
            t.textContent = text;
            toasts.appendChild(t);
            setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 200); }, 3500);
        }

        // ─── Enumerate Mic Devices ───
        async function enumerateMicDevices() {
            try {
                const devices = await navigator.mediaDevices.enumerateDevices();
                const audioInputs = devices.filter(d => d.kind === 'audioinput');
                micDeviceSelect.innerHTML = '';
                audioInputs.forEach((device, index) => {
                    const opt = document.createElement('option');
                    opt.value = device.deviceId;
                    opt.textContent = device.label || `Microphone ${index + 1}`;
                    if (device.deviceId === selectedMicId) opt.selected = true;
                    micDeviceSelect.appendChild(opt);
                });
            } catch (e) {}
        }

        dockSettingsBtn.onclick = () => {
            settingsOpen = !settingsOpen;
            settingsMenu.classList.toggle('active', settingsOpen);
            if (settingsOpen) enumerateMicDevices();
        };

        micDeviceSelect.onchange = () => {
            selectedMicId = micDeviceSelect.value;
            if (micEnabled) enableMic();
        };

        // ─── Pre-Join & Unlocking Audio Permission ───
        joinBtn.onclick = () => {
            const name = joinName.value.trim();
            if (!name) { joinError.textContent = 'Please enter your name'; return; }
            myName = name;
            joinError.textContent = '';
            joinBtn.disabled = true;
            joinBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Joining...';

            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
            } catch (e) {}

            try {
                hostAudio.play().catch(() => {});
                hostVideo.play().catch(() => {});
            } catch (e) {}

            connectStatusWs();
        };

        joinName.onkeydown = (e) => { if (e.key === 'Enter') joinBtn.click(); };

        // ─── WebSocket Signaling ───
        function connectStatusWs() {
            const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
            statusWs = new WebSocket(`${protocol}//${location.host}/view-ws?key=${encodeURIComponent(streamKey)}`);

            statusWs.onopen = () => {
                statusWs.send(JSON.stringify({ type: 'JOIN_REQUEST', name: myName }));
            };

            statusWs.onmessage = (event) => {
                try {
                    const data = JSON.parse(event.data);
                    handleWsMessage(data);
                } catch (e) {}
            };

            statusWs.onclose = () => {
                if (screens.main.classList.contains('active')) {
                    setTimeout(connectStatusWs, 3000);
                }
            };
        }

        function handleWsMessage(data) {
            switch (data.type) {
                case 'JOIN_PENDING':
                    showScreen('waiting');
                    break;

                case 'JOIN_APPROVED':
                    myParticipantId = data.participantId;
                    showScreen('main');
                    break;

                case 'JOIN_DENIED':
                    joinError.textContent = data.reason || 'Access denied by host';
                    joinBtn.disabled = false;
                    joinBtn.innerHTML = '<i class="fa-solid fa-video" style="margin-right:4px;"></i>Ask to join';
                    break;

                case 'KICKED':
                    showScreen('kicked');
                    $('kicked-reason').textContent = data.reason || 'Removed by host';
                    if (statusWs) statusWs.close();
                    if (pc) { pc.close(); pc = null; }
                    break;

                case 'STATUS':
                    isLive = data.live;
                    isScreenSharing = !!data.isScreenSharing;
                    updateStageLayout();
                    break;

                case 'PARTICIPANT_LIST':
                    if (data.participants) {
                        participants = data.participants;
                        peopleCount.textContent = participants.length;
                        renderPeopleList();
                        renderMeetGrid();
                    }
                    break;

                case 'TALK_PERMISSION':
                    canTalk = data.allowed;
                    dockMicBtn.disabled = !canTalk;
                    if (!canTalk && micEnabled) disableMic();
                    toast(canTalk ? 'Microphone unmuted by host' : 'Host muted your microphone');
                    break;

                case 'CHAT_MESSAGE':
                    addChatMessage(data.from, data.text);
                    break;

                case 'VIEWER_WEBRTC_ANSWER':
                    if (pc && data.sdp) {
                        pc.setRemoteDescription({ type: 'answer', sdp: data.sdp }).catch(() => {});
                    }
                    break;

                case 'VIEWER_ICE_CANDIDATE':
                    if (pc && data.candidate) {
                        pc.addIceCandidate(data.candidate).catch(() => {});
                    }
                    break;
            }
        }

        function updateStageLayout() {
            const hasVideoTrack = remoteStream && remoteStream.getVideoTracks().some(t => t.readyState === 'live' && t.enabled);
            if (isLive && (isScreenSharing || hasVideoTrack)) {
                meetVideoContainer.classList.add('active');
                meetGrid.style.display = 'none';
                modeText.textContent = 'Screen Shared';
            } else {
                meetVideoContainer.classList.remove('active');
                meetGrid.style.display = 'grid';
                modeText.textContent = 'Voice Call';
            }
        }

        // ─── WebRTC Voice & Movie Stream ───
        function startWebRtcViewer() {
            if (pc) { pc.close(); pc = null; }
            remoteStream = new MediaStream();

            pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });

            pc.ontrack = (event) => {
                const stream = event.streams && event.streams[0] ? event.streams[0] : remoteStream;
                for (const track of stream.getTracks()) {
                    if (!remoteStream.getTracks().some(t => t.id === track.id)) remoteStream.addTrack(track);
                }
                hostVideo.srcObject = remoteStream;
                hostAudio.srcObject = remoteStream;
                
                hostAudio.play().catch(() => {});
                hostVideo.play().catch(() => {});
            };

            pc.onicecandidate = (event) => {
                if (event.candidate && statusWs && statusWs.readyState === WebSocket.OPEN) {
                    statusWs.send(JSON.stringify({ type: 'VIEWER_ICE_CANDIDATE', candidate: event.candidate }));
                }
            };

            pc.addTransceiver('video', { direction: 'recvonly' });
            pc.addTransceiver('audio', { direction: 'sendrecv' });

            pc.createOffer().then(offer => {
                let sdp = offer.sdp;
                sdp = sdp.replace(/(a=fmtp:111 [^\r\n]+)/, "$1;stereo=1;sprop-stereo=1;maxaveragebitrate=510000;cbr=1;useinbandfec=1");
                return pc.setLocalDescription({ type: 'offer', sdp });
            }).then(() => {
                if (statusWs && statusWs.readyState === WebSocket.OPEN) {
                    statusWs.send(JSON.stringify({ type: 'VIEWER_WEBRTC_OFFER', sdp: pc.localDescription.sdp }));
                }
            }).catch(() => {});
        }

        // ─── Microphone Controls ───
        dockMicBtn.onclick = () => {
            if (!canTalk) return;
            micEnabled ? disableMic() : enableMic();
        };

        async function enableMic() {
            try {
                const constraints = { audio: { echoCancellation: true, noiseSuppression: true } };
                if (selectedMicId) constraints.audio.deviceId = { exact: selectedMicId };

                micStream = await navigator.mediaDevices.getUserMedia(constraints);
                if (pc && micStream.getAudioTracks().length > 0) {
                    const audioTrack = micStream.getAudioTracks()[0];
                    const existingSender = pc.getSenders().find(s => s.track && s.track.kind === 'audio');
                    if (existingSender) {
                        await existingSender.replaceTrack(audioTrack);
                    } else {
                        pc.addTrack(audioTrack, micStream);
                    }
                }
                micEnabled = true;
                dockMicBtn.classList.remove('off');
                dockMicBtn.classList.add('active');
                dockMicBtn.querySelector('i').className = 'fa-solid fa-microphone';
                if (statusWs && statusWs.readyState === WebSocket.OPEN) {
                    statusWs.send(JSON.stringify({ type: 'MIC_TOGGLE', enabled: true }));
                }
                toast('Microphone unmuted');
            } catch (e) {
                toast('Could not access microphone');
            }
        }

        function disableMic() {
            if (micStream) {
                micStream.getTracks().forEach(t => t.stop());
                micStream = null;
            }
            micEnabled = false;
            dockMicBtn.classList.add('off');
            dockMicBtn.classList.remove('active');
            dockMicBtn.querySelector('i').className = 'fa-solid fa-microphone-slash';
            if (statusWs && statusWs.readyState === WebSocket.OPEN) {
                statusWs.send(JSON.stringify({ type: 'MIC_TOGGLE', enabled: false }));
            }
            toast('Microphone muted');
        }

        // ─── Full Screen Toggle ───
        dockFullscreenBtn.onclick = () => {
            const stage = $('main-screen');
            if (document.fullscreenElement) {
                document.exitFullscreen().catch(() => {});
            } else {
                (stage.requestFullscreen || stage.webkitRequestFullscreen).call(stage);
            }
        };

        // ─── Sidebar Drawer (Chat & People) ───
        function toggleSidebar(tab) {
            if (sidebarOpen && activeTab === tab) {
                meetSidebar.classList.remove('active');
                sidebarOpen = false;
                dockChatBtn.classList.remove('active');
                dockPeopleBtn.classList.remove('active');
                return;
            }

            activeTab = tab;
            sidebarOpen = true;
            meetSidebar.classList.add('active');
            
            tabChatBtn.classList.toggle('active', tab === 'chat');
            tabPeopleBtn.classList.toggle('active', tab === 'people');
            bodyChat.classList.toggle('active', tab === 'chat');
            bodyPeople.classList.toggle('active', tab === 'people');
            
            dockChatBtn.classList.toggle('active', tab === 'chat');
            dockPeopleBtn.classList.toggle('active', tab === 'people');
        }

        dockChatBtn.onclick = () => toggleSidebar('chat');
        dockPeopleBtn.onclick = () => toggleSidebar('people');
        tabChatBtn.onclick = () => toggleSidebar('chat');
        tabPeopleBtn.onclick = () => toggleSidebar('people');
        sidebarClose.onclick = () => {
            meetSidebar.classList.remove('active');
            sidebarOpen = false;
            dockChatBtn.classList.remove('active');
            dockPeopleBtn.classList.remove('active');
        };

        function sendChat() {
            const text = chatInput.value.trim();
            if (!text || !statusWs || statusWs.readyState !== WebSocket.OPEN) return;
            statusWs.send(JSON.stringify({ type: 'CHAT_MESSAGE', text }));
            chatInput.value = '';
        }
        chatSend.onclick = sendChat;
        chatInput.onkeydown = (e) => { if (e.key === 'Enter') sendChat(); };

        function addChatMessage(from, text) {
            const item = document.createElement('div');
            const isOwn = (from === myName);
            item.className = 'chat-item' + (isOwn ? ' own' : '');
            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            
            item.innerHTML = `
                <div class="chat-header">
                    <span class="author">${escapeHtml(isOwn ? 'You' : from)}</span>
                    <span>${timeStr}</span>
                </div>
                <div class="chat-bubble">${escapeHtml(text)}</div>
            `;
            chatList.appendChild(item);
            chatList.scrollTop = chatList.scrollHeight;
        }

        function renderPeopleList() {
            peopleList.innerHTML = '';
            participants.forEach(p => {
                const row = document.createElement('div');
                row.className = 'person-row';
                const initial = (p.name || 'U').charAt(0).toUpperCase();
                row.innerHTML = `
                    <div class="person-info-group">
                        <div class="person-avatar" ${p.role === 'host' ? 'style="background:#1a73e8;"' : ''}>${initial}</div>
                        <div class="person-name">${escapeHtml(p.name)} ${p.role === 'host' ? '(Host)' : (p.id === myParticipantId ? '(You)' : '')}</div>
                    </div>
                    <i class="fa-solid ${p.micEnabled ? 'fa-microphone' : 'fa-microphone-slash'}" style="color:${p.micEnabled ? '#34a853' : 'var(--meet-subtext)'}; font-size:1rem;"></i>
                `;
                peopleList.appendChild(row);
            });
        }

        // ─── Adaptive Grid Rendering (1, 2, 3... 10 participants) ───
        function renderMeetGrid() {
            meetGrid.innerHTML = '';
            const count = participants.length;

            if (count === 1) {
                meetGrid.style.gridTemplateColumns = '1fr';
                meetGrid.style.gridTemplateRows = '1fr';
            } else if (count === 2) {
                meetGrid.style.gridTemplateColumns = '1fr 1fr';
                meetGrid.style.gridTemplateRows = '1fr';
            } else if (count <= 4) {
                meetGrid.style.gridTemplateColumns = '1fr 1fr';
                meetGrid.style.gridTemplateRows = '1fr 1fr';
            } else if (count <= 6) {
                meetGrid.style.gridTemplateColumns = 'repeat(3, 1fr)';
                meetGrid.style.gridTemplateRows = '1fr 1fr';
            } else {
                meetGrid.style.gridTemplateColumns = 'repeat(4, 1fr)';
                meetGrid.style.gridTemplateRows = 'auto';
            }

            participants.forEach(p => {
                const card = document.createElement('div');
                card.className = 'meet-card' + (p.micEnabled ? ' speaking' : '');
                const initial = (p.name || 'U').charAt(0).toUpperCase();
                card.innerHTML = `
                    <div class="meet-avatar" ${p.role === 'host' ? 'style="background:#1a73e8;"' : ''}>${initial}</div>
                    <div class="meet-name-tag"><span>${escapeHtml(p.name)} ${p.role === 'host' ? '👑' : ''} ${p.id === myParticipantId ? '(You)' : ''}</span></div>
                    <div class="meet-card-mic ${p.micEnabled ? '' : 'off'}">
                        <i class="fa-solid ${p.micEnabled ? 'fa-microphone' : 'fa-microphone-slash'}"></i>
                    </div>
                `;
                meetGrid.appendChild(card);
            });
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        dockEndBtn.onclick = () => {
            if (confirm('Leave meeting?')) {
                location.href = '/';
            }
        };
    })();
    </script>
</body>
</html>
