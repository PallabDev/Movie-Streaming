<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>
        <%= stream.title %> | CoWatch Player
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/output.css">
    <style>
        /* Center play button and improved controls transitions */
        :root {
            --progress-bg: #2a323b;
            --progress-fill: #82A3A1;
            --value: 100%;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            min-height: 100vh;
            min-height: 100dvh;
            overflow: hidden;
            background: #000000;
        }

        .sh-player {
            width: 100%;
            max-width: 100%;
            max-height: 100dvh;
            aspect-ratio: 16/9;
            background: #000;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
            transition: all 0.3s ease;
        }

        @media (min-width: 1200px) {
            .sh-player {
                max-width: 1200px;
                border-radius: 12px;
            }
        }

        :fullscreen .sh-player,
        :-webkit-full-screen .sh-player,
        :-moz-full-screen .sh-player {
            border-radius: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            max-height: none !important;
            aspect-ratio: auto !important;
        }

        #sh-controls {
            padding-bottom: calc(env(safe-area-inset-bottom) + 1.25rem) !important;
        }

        /* Smooth controls hide transition */
        #sh-controls {
            transition: opacity 0.22s ease, transform 0.18s ease;
        }
    </style>
</head>

<body class="flex items-center justify-center bg-black" style="display:flex; align-items:center; justify-content:center;">

    <div class="sh-player group" id="sh-player-container">

        <!-- HTML5 Video Element -->
        <video id="sh-video" class="w-full h-full object-contain cursor-pointer" playsinline webkit-playsinline
            muted></video>


        <!-- Loading Spinner -->
        <div id="sh-loading"
            class="absolute inset-0 flex items-center justify-center bg-black/60 backdrop-blur-sm z-30 pointer-events-none transition-opacity duration-300"
            style="display: none;">
            <div class="flex flex-col items-center gap-3">
                <div class="w-12 h-12 border-4 border-indigo-500/30 border-t-indigo-500 rounded-full animate-spin">
                </div>
                <span class="text-xs font-semibold text-slate-300 tracking-wider uppercase">Loading Stream...</span>
            </div>
        </div>

        <!-- Center Play Button Overlay -->
        <div id="play-overlay"
            class="absolute inset-0 flex items-center justify-center cursor-pointer"
            style="display: none; z-index: 35;">
            <div class="w-20 h-20 rounded-full bg-white/15 backdrop-blur-md border border-white/20 flex items-center justify-center transition-all hover:scale-110 hover:bg-white/25 shadow-2xl">
                <i class="fa-solid fa-play text-white text-3xl ml-1"></i>
            </div>
        </div>

        <!-- Stream Offline Overlay -->
        <div id="offline-screen"
            class="absolute inset-0 bg-slate-950 flex flex-col items-center justify-center p-6 text-center z-40"
            style="display: none;">
            <div
                class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 text-2xl mb-4">
                <i class="fa-solid fa-satellite-dish animate-pulse"></i>
            </div>
            <h2 class="text-2xl font-bold text-white mb-2">Stream Offline</h2>
            <p class="text-slate-400 text-xs max-w-sm mb-6">
                The broadcaster is currently offline or reconnecting. The player will automatically resume when live.
            </p>
            <button onclick="checkStreamStatus()"
                class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-all shadow-lg shadow-indigo-600/30 flex items-center gap-2">
                <i class="fa-solid fa-rotate-right"></i>
                <span>Refresh Status</span>
            </button>
        </div>

        <!-- Top Header Info Bar -->
        <div id="top-header"
            class="absolute top-0 left-0 right-0 p-4 sm:p-6 bg-gradient-to-b from-black/80 via-black/40 to-transparent flex items-center justify-between z-20 pointer-events-none transition-all duration-300">
            <div class="flex items-center gap-2 pointer-events-auto">
                <span
                    class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-500/20 text-red-400 border border-red-500/30 flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span> LIVE
                </span>
                <span id="conn-badge"
                    class="px-2 py-0.5 rounded text-[10px] font-semibold bg-green-500/20 text-green-400 border border-green-500/30 flex items-center gap-1">
                    <span id="conn-dot" class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
                    <span id="conn-label">Stable</span>
                </span>
            </div>
        </div>

        <!-- Custom Player Controls Bar -->
        <div id="sh-controls"
            class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-20 flex flex-col gap-3 transition-all duration-300">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <button id="sh-mute-btn"
                        class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-base transition-colors">
                        <i class="fa-solid fa-volume-xmark" id="sh-mute-icon"></i>
                    </button>
                    <span id="sh-current-time" class="text-xs font-mono text-slate-300 font-semibold">00:00</span>
                </div>

                <div class="flex items-center gap-3 relative">
                    <!-- Quality Badge -->
                    <span id="quality-badge"
                        class="px-2 py-0.5 rounded text-[10px] font-semibold bg-indigo-500/20 text-indigo-400 border border-indigo-500/30">720p WebRTC</span>

                    <!-- Fullscreen Button -->
                    <button id="sh-full-btn"
                        class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-base transition-colors">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                </div>
            </div>
        </div>

    </div>

    <script>
            (function () {
                const player = document.getElementById('sh-player-container');
                const video = document.getElementById('sh-video');
                const muteBtn = document.getElementById('sh-mute-btn');
                const muteIcon = document.getElementById('sh-mute-icon');
                const currentTimeEl = document.getElementById('sh-current-time');
                const fullBtn = document.getElementById('sh-full-btn');
                const loadingSpinner = document.getElementById('sh-loading');
                const controls = document.getElementById('sh-controls');
                const topHeader = document.getElementById('top-header');
                const offlineScreen = document.getElementById('offline-screen');
                const playOverlay = document.getElementById('play-overlay');
                const connBadge = document.getElementById('conn-badge');
                const connDot = document.getElementById('conn-dot');
                const connLabel = document.getElementById('conn-label');
                const qualityBadge = document.getElementById('quality-badge');

                const currentStreamKey = '<%= typeof streamKey !== "undefined" ? streamKey : "default" %>';

                let pc = null;
                let statusWs = null;
                let controlsTimeout = null;
                let remoteStream = null;
                let playPending = false;
                const STREAM_TARGET = {
                    height: 720,
                    fps: 30,
                    bitrate: 6000000
                };

                function showControls() {
                    controls.style.opacity = '1';
                    controls.style.pointerEvents = 'auto';
                    if (topHeader) topHeader.style.opacity = '1';
                    resetControlsTimer();
                }

                function hideControls() {
                    if (!video.paused) {
                        controls.style.opacity = '0';
                        controls.style.pointerEvents = 'none';
                        if (topHeader) topHeader.style.opacity = '0';
                    }
                }

                function resetControlsTimer() {
                    if (controlsTimeout) clearTimeout(controlsTimeout);
                    controlsTimeout = setTimeout(hideControls, 3000);
                }

                player.addEventListener('mousemove', showControls);
                player.addEventListener('touchstart', showControls, { passive: true });
                player.addEventListener('touchmove', showControls, { passive: true });
                player.addEventListener('click', showControls);

                playOverlay.addEventListener('click', () => {
                    hidePlayOverlay();
                    startWebRtcViewer();
                });

                function showOffline() {
                    offlineScreen.style.display = 'flex';
                    hideLoading();
                    if (pc) { pc.close(); pc = null; }
                    remoteStream = null;
                    video.srcObject = null;
                    video.pause();
                }

                function hideOffline() {
                    offlineScreen.style.display = 'none';
                }

                function showPlayOverlay() {
                    playOverlay.style.display = 'flex';
                }

                function hidePlayOverlay() {
                    playOverlay.style.display = 'none';
                }

                function showLoading() {
                    loadingSpinner.style.display = 'flex';
                }

                function hideLoading() {
                    loadingSpinner.style.display = 'none';
                }

                function formatTime(sec) {
                    if (!sec || !isFinite(sec)) return '00:00';
                    const s = Math.floor(sec % 60);
                    const m = Math.floor(sec / 60);
                    return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
                }

                ['click', 'pointerdown', 'pointerup', 'touchend', 'touchstart'].forEach(evt => {
                    player.addEventListener(evt, (e) => {
                        if (e.target && e.target.closest && (e.target.closest('#sh-controls'))) return;
                        if (e.target && e.target.closest && (e.target.closest('#play-overlay'))) return;
                        if (e.target && (e.target.tagName === 'BUTTON' || e.target.tagName === 'A' || e.target.closest('button') || e.target.closest('a'))) return;
                        if (evt === 'touchstart' || (evt === 'pointerdown' && e.pointerType === 'touch')) {
                            try { showControls(); } catch (err) { }
                        }
                        try { e.stopImmediatePropagation(); } catch (e) { }
                        e.stopPropagation();
                        e.preventDefault();
                    }, true);

                    video.addEventListener(evt, (e) => {
                        try { e.stopImmediatePropagation(); } catch (e) { }
                        e.stopPropagation();
                        e.preventDefault();
                    }, true);
                });

                muteBtn.addEventListener('click', () => {
                    video.muted = !video.muted;
                    muteIcon.className = video.muted ? 'fa-solid fa-volume-xmark' : 'fa-solid fa-volume-high';
                });

                video.addEventListener('timeupdate', () => {
                    currentTimeEl.textContent = formatTime(video.currentTime || 0);
                });

                video.addEventListener('play', () => { hideLoading(); });
                video.addEventListener('pause', () => { showControls(); });

                async function toggleFullscreen() {
                    if (document.fullscreenElement || document.webkitFullscreenElement) {
                        try {
                            if (document.exitFullscreen) await document.exitFullscreen();
                            else if (document.webkitExitFullscreen) await document.webkitExitFullscreen();
                        } catch (e) { }
                        if (screen.orientation && typeof screen.orientation.unlock === 'function') {
                            try { screen.orientation.unlock(); } catch (e) { }
                        }
                    } else {
                        try {
                            if (player.requestFullscreen) await player.requestFullscreen();
                            else if (player.webkitRequestFullscreen) await player.webkitRequestFullscreen();
                        } catch (e) { }
                        if (screen.orientation && typeof screen.orientation.lock === 'function') {
                            try { await screen.orientation.lock('landscape'); } catch (e) { }
                        }
                    }
                }

                fullBtn.addEventListener('click', toggleFullscreen);

                if (qualityBadge) {
                    qualityBadge.textContent = '720p 30fps';
                    qualityBadge.style.cursor = 'default';
                }

                function preferVideoCodec(transceiver) {
                    try {
                        if (!transceiver || !RTCRtpReceiver.getCapabilities) return;
                        const capabilities = RTCRtpReceiver.getCapabilities('video');
                        if (!capabilities || !Array.isArray(capabilities.codecs)) return;
                        const codecs = capabilities.codecs;
                        const preferred = codecs.filter(codec => /video\/H264/i.test(codec.mimeType));
                        const fallback = codecs.filter(codec => !/video\/H264/i.test(codec.mimeType));
                        if (preferred.length && transceiver.setCodecPreferences) {
                            transceiver.setCodecPreferences([...preferred, ...fallback]);
                        }
                    } catch (e) { }
                }

                // ─── WebRTC Viewer Relay ──────────────────────────────────────────────
                let viewerStarted = false;

                async function startWebRtcViewer() {
                    if (viewerStarted) return;
                    viewerStarted = true;
                    if (pc) { pc.close(); pc = null; }
                    remoteStream = new MediaStream();
                    showLoading();
                    hideOffline();

                    pc = new RTCPeerConnection({
                        iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
                    });

                    pc.ontrack = (event) => {
                        const stream = event.streams && event.streams[0] ? event.streams[0] : remoteStream;
                        for (const track of stream.getTracks()) {
                            if (!remoteStream.getTracks().some(existing => existing.id === track.id)) {
                                remoteStream.addTrack(track);
                            }
                        }
                        if (!remoteStream.getTracks().some(track => track.id === event.track.id)) {
                            remoteStream.addTrack(event.track);
                        }
                        if (video.srcObject !== remoteStream) {
                            video.srcObject = remoteStream;
                        }
                        if (!playPending) {
                            playPending = true;
                            video.play().then(() => {
                                hideLoading();
                                showControls();
                            }).catch(err => {
                                console.warn('[WebRTC Viewer] autoplay blocked or delayed:', err);
                                hideLoading();
                                showControls();
                            }).finally(() => { playPending = false; });
                        }
                    };

                    pc.oniceconnectionstatechange = () => {
                        const state = pc.iceConnectionState;
                        console.log('[WebRTC Viewer] ICE state:', state);
                        if (state === 'connected' || state === 'completed') {
                            updateConnViewer('stable');
                        } else if (state === 'disconnected') {
                            updateConnViewer('slow');
                            viewerStarted = false;
                            setTimeout(() => {
                                if (!viewerStarted) {
                                    showPlayOverlay();
                                }
                            }, 5000);
                        } else if (state === 'failed') {
                            updateConnViewer('poor');
                            viewerStarted = false;
                            showPlayOverlay();
                        }
                    };

                    pc.onicecandidate = (event) => {
                        if (event.candidate && statusWs && statusWs.readyState === WebSocket.OPEN) {
                            statusWs.send(JSON.stringify({
                                type: 'VIEWER_ICE_CANDIDATE',
                                candidate: event.candidate
                            }));
                        }
                    };

                    const videoTransceiver = pc.addTransceiver('video', { direction: 'recvonly' });
                    preferVideoCodec(videoTransceiver);
                    pc.addTransceiver('audio', { direction: 'recvonly' });

                    const offer = await pc.createOffer();
                    await pc.setLocalDescription(offer);

                    if (statusWs && statusWs.readyState === WebSocket.OPEN) {
                        console.log('[WebRTC Viewer] Sending offer');
                        statusWs.send(JSON.stringify({
                            type: 'VIEWER_WEBRTC_OFFER',
                            sdp: pc.localDescription.sdp
                        }));
                    }
                }

                function updateConnViewer(level) {
                    const colors = { good: '#22c55e', stable: '#10b981', slow: '#f59e0b', poor: '#ef4444' };
                    const labels = { good: 'Good', stable: 'Stable', slow: 'Reconnecting', poor: 'Poor' };
                    const bgColors = { good: 'bg-green-500/20', stable: 'bg-green-500/20', slow: 'bg-amber-500/20', poor: 'bg-red-500/20' };
                    const textColors = { good: 'text-green-400', stable: 'text-green-400', slow: 'text-amber-400', poor: 'text-red-400' };
                    const borderColors = { good: 'border-green-500/30', stable: 'border-green-500/30', slow: 'border-amber-500/30', poor: 'border-red-500/30' };
                    if (connDot) connDot.style.background = colors[level] || colors.stable;
                    if (connLabel) connLabel.textContent = labels[level] || 'Stable';
                    if (connBadge) {
                        connBadge.className = connBadge.className
                            .replace(/bg-\w+-500\/20/g, '').replace(/text-\w+-400/g, '').replace(/border-\w+-500\/30/g, '')
                            + ' ' + (bgColors[level] || bgColors.stable) + ' ' + (textColors[level] || textColors.stable) + ' ' + (borderColors[level] || borderColors.stable);
                    }
                }

                function connectStatusWebSocket() {
                    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                    const wsUrl = `${protocol}//${window.location.host}/view-ws?key=${encodeURIComponent(currentStreamKey)}`;
                    statusWs = new WebSocket(wsUrl);

                    statusWs.onopen = () => {
                        console.log('[Viewer WS] Connected');
                    };

                    statusWs.onmessage = async (event) => {
                        try {
                            const data = JSON.parse(event.data);
                            if (data.type === 'STATUS') {
                                if (data.live) {
                                    hideOffline();
                                    if (!viewerStarted) {
                                        showPlayOverlay();
                                    }
                                } else {
                                    showOffline();
                                    hidePlayOverlay();
                                    viewerStarted = false;
                                    if (pc) { pc.close(); pc = null; }
                                    remoteStream = null;
                                    video.srcObject = null;
                                }
                            } else if (data.type === 'VIEWER_WEBRTC_ANSWER') {
                                if (pc && data.sdp) {
                                    await pc.setRemoteDescription({ type: 'answer', sdp: data.sdp });
                                }
                            } else if (data.type === 'VIEWER_ICE_CANDIDATE') {
                                if (pc && data.candidate) {
                                    try { await pc.addIceCandidate(data.candidate); } catch (e) { }
                                }
                            } else if (data.type === 'HOST_HEALTH') {
                                if (data.health === 'poor') {
                                    updateConnViewer('poor');
                                } else if (data.health === 'slow') {
                                    updateConnViewer('slow');
                                }
                            }
                        } catch (err) { console.error('[Viewer WS]', err); }
                    };

                    statusWs.onclose = () => setTimeout(connectStatusWebSocket, 3000);
                }

                window.checkStreamStatus = function () {
                    showLoading();
                    fetch('/live/status/' + currentStreamKey)
                        .then(res => res.json())
                        .then(data => {
                            hideLoading();
                            if (data.live) {
                                hideOffline();
                                showPlayOverlay();
                            } else {
                                showOffline();
                            }
                        })
                        .catch(() => showOffline());
                };

                connectStatusWebSocket();
            })();
    </script>
</body>

</html>
