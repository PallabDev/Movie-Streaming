<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>
        <%= stream.title %> | CoWatch Player
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: '#82A3A1',
                        'accent-dark': '#465362',
                        secondary: '#9FC490',
                        'control-bg': 'rgba(18, 22, 26, 0.95)',
                        'glass-bg': 'rgba(70, 83, 98, 0.4)',
                        'glass-border': 'rgba(130, 163, 161, 0.25)',
                    },
                    animation: {
                        'spin-slow': 'spin 1s linear infinite',
                        'pulse-slow': 'pulse 2s ease-in-out infinite',
                    },
                    backdropBlur: {
                        'glass': '10px',
                    },
                }
            }
        }
    </script>
    <style>
        :root {
            --progress-bg: #2a323b;
            --progress-fill: #82A3A1;
            --value: 100%;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000000;
        }

        .sh-progress-bar {
            background: linear-gradient(90deg, #6366f1, #4f46e5);
        }

        .sh-player {
            width: 100%;
            max-width: 100%;
            max-height: 100dvh;
            aspect-ratio: 16/9;
            background: #000;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
            transition: all 0.3s ease;
        }

        @media (min-width: 1200px) {
            .sh-player {
                max-width: 1200px;
                border-radius: 12px;
            }
        }

        :fullscreen .sh-player,
        :-webkit-full-screen .sh-player,
        :-moz-full-screen .sh-player {
            border-radius: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            max-height: none !important;
            aspect-ratio: auto !important;
        }

        #sh-controls {
            padding-bottom: calc(env(safe-area-inset-bottom) + 1.25rem) !important;
        }

        .sh-quality-menu {
            display: none;
            position: absolute;
            bottom: 4rem;
            right: 1.5rem;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 0.5rem;
            z-index: 40;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            min-width: 150px;
        }

        .sh-quality-menu.active {
            display: block;
        }

        .sh-quality-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem 0.75rem;
            font-size: 0.85rem;
            font-weight: 500;
            color: #cbd5e1;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .sh-quality-item:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
        }

        .sh-quality-item.selected {
            background: rgba(99, 102, 241, 0.25);
            color: #818cf8;
            font-weight: 600;
        }

        @media (max-width: 600px) {
            #sh-controls {
                padding: 0.75rem !important;
                padding-bottom: calc(env(safe-area-inset-bottom) + 0.75rem) !important;
                gap: 0.5rem !important;
            }

            .sh-play-btn {
                width: 2.25rem !important;
                height: 2.25rem !important;
            }

            .sh-btn {
                width: 2rem !important;
                height: 2rem !important;
            }

            #sh-current-time,
            #sh-duration {
                font-size: 0.75rem !important;
                min-width: 36px !important;
            }
        }
    </style>
</head>

<body class="bg-[#000000] m-0 p-0 font-['Inter',system-ui,sans-serif] text-white">
    <!-- Full-screen container -->
    <div class="w-screen h-[100dvh] flex items-center justify-center bg-black relative overflow-hidden">
        <!-- Player container -->
        <div class="sh-player" id="sh-player">
            <video class="w-full h-full object-contain bg-black block" id="sh-video" preload="auto" playsinline
                style="image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges;"></video>

            <!-- Offline Screen Overlay -->
            <div id="offline-screen"
                class="fixed inset-0 bg-[#0f172a] z-50 flex flex-col justify-center items-center text-center p-6"
                style="display: flex;">
                <div class="text-indigo-500 text-6xl mb-4 animate-pulse">
                    <i class="fa-solid fa-satellite-dish"></i>
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">Stream is Offline</h3>
                <p class="text-slate-400 text-sm max-w-sm mb-6">
                    The broadcaster is not streaming live right now. The feed will automatically play once they start
                    broadcasting.
                </p>
                <button
                    class="px-6 py-2.5 rounded-full bg-indigo-600 hover:bg-indigo-500 font-semibold text-sm transition-all hover:scale-105"
                    onclick="checkStreamStatus()">
                    <i class="fa-solid fa-arrows-rotate mr-1.5"></i> Check Again
                </button>
            </div>

            <!-- Loading Spinner -->
            <div class="absolute inset-0 flex items-center justify-center z-[5] pointer-events-none">
                <div class="w-10 h-10 sm:w-[60px] sm:h-[60px] border-4 border-solid border-white/10 border-t-accent rounded-full hidden animate-spin pointer-events-auto"
                    id="sh-loading"></div>
            </div>

            <!-- Quality Settings Popup Menu -->
            <div class="sh-quality-menu" id="sh-quality-menu">
                <div class="text-xs font-semibold text-slate-400 px-2 py-1 mb-1 uppercase tracking-wider">Quality</div>
                <div class="sh-quality-item selected" data-quality="auto" onclick="setQuality(-1)">
                    <span>Auto</span>
                    <i class="fas fa-check text-xs" id="check-auto"></i>
                </div>
                <div class="sh-quality-item" data-quality="720" onclick="setQuality(720)">
                    <span>720p</span>
                    <i class="fas fa-check text-xs hidden" id="check-720"></i>
                </div>
                <div class="sh-quality-item" data-quality="480" onclick="setQuality(480)">
                    <span>480p</span>
                    <i class="fas fa-check text-xs hidden" id="check-480"></i>
                </div>
            </div>

            <!-- Controls -->
            <div class="absolute left-0 right-0 bottom-0 p-4 sm:p-6 bg-gradient-to-t from-black/95 via-black/70 to-transparent flex flex-col gap-3 transition-all duration-150 z-10"
                id="sh-controls">
                <!-- Row 1: Progress & Time -->
                <div class="flex items-center w-full gap-3 min-w-0">
                    <span
                        class="text-xs sm:text-sm font-medium text-[#aaaaaa] min-w-[42px] sm:min-w-[50px] font-mono tabular-nums"
                        id="sh-current-time">
                        00:00
                    </span>

                    <div class="sh-progress relative flex-1 h-1.5 sm:h-2 rounded-full bg-[#3a3a3a] cursor-pointer overflow-hidden transition-all duration-150 hover:h-2 sm:hover:h-2.5"
                        id="sh-progress">
                        <div class="sh-progress-buffer absolute top-0 left-0 bottom-0 w-0 rounded-full bg-white/20"
                            id="sh-progress-buffer"></div>
                        <div class="sh-progress-bar absolute top-0 left-0 bottom-0 w-0 rounded-full"
                            id="sh-progress-bar"></div>
                        <div class="sh-progress-handle absolute top-1/2 -translate-y-1/2 w-0 h-0 rounded-full bg-white shadow-none transition-all duration-150 pointer-events-none"
                            id="sh-progress-handle"></div>
                    </div>

                    <span
                        class="text-xs sm:text-sm font-medium text-[#aaaaaa] min-w-[42px] sm:min-w-[50px] font-mono tabular-nums"
                        id="sh-duration">
                        00:00
                    </span>
                </div>

                <!-- Row 2: Control Buttons -->
                <div class="flex items-center justify-between w-full">
                    <!-- Play / Pause (Left) -->
                    <button
                        class="sh-play-btn w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-accent text-white flex items-center justify-center text-lg transition-all duration-150 shadow-[0_4px_12px_rgba(99,102,241,0.4)] hover:bg-accent-dark hover:scale-105 hover:shadow-[0_6px_16px_rgba(99,102,241,0.5)]"
                        id="sh-play-btn" aria-label="Play/Pause">
                        <i class="fas fa-play" id="sh-play-icon"></i>
                    </button>

                    <!-- Right Action Controls -->
                    <div class="sh-controls-right flex items-center gap-1.5 sm:gap-2">
                        <!-- Live Badge -->
                        <div id="liveBadge"
                            class="text-xs font-semibold px-2.5 py-1 rounded-full bg-red-500/20 text-red-400 border border-red-500/30 flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span>
                            <span>LIVE</span>
                        </div>

                        <!-- Quality Selector Toggle Button -->
                        <button
                            class="sh-btn w-8 h-8 sm:w-10 sm:h-10 bg-transparent text-[#aaaaaa] flex items-center justify-center text-sm p-2 rounded-lg transition-all duration-150 hover:text-white hover:bg-white/10"
                            id="sh-quality-btn" title="Quality Settings">
                            <i class="fas fa-cog" id="sh-quality-icon"></i>
                        </button>

                        <!-- Volume Button -->
                        <button
                            class="sh-btn w-8 h-8 sm:w-10 sm:h-10 bg-transparent text-[#aaaaaa] flex items-center justify-center text-lg p-2 rounded-lg transition-all duration-150 hover:text-white hover:bg-white/10 min-w-[32px]"
                            id="sh-volume-btn" title="Mute/Unmute">
                            <i class="fas fa-volume-up" id="sh-volume-icon"></i>
                        </button>

                        <!-- Fullscreen -->
                        <button
                            class="sh-btn sh-full-btn w-8 h-8 sm:w-10 sm:h-10 rounded-lg bg-white/10 flex items-center justify-center text-lg transition-all duration-150 hover:bg-white/20 hover:scale-105"
                            id="sh-full-btn" title="Fullscreen">
                            <i class="fas fa-expand" id="sh-fullscreen-icon"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
            (function () {
                const video = document.getElementById('sh-video');
                const player = document.getElementById('sh-player');
                const playBtn = document.getElementById('sh-play-btn');
                const playIcon = document.getElementById('sh-play-icon');
                const currentTimeEl = document.getElementById('sh-current-time');
                const durationEl = document.getElementById('sh-duration');
                const progress = document.getElementById('sh-progress');
                const progressBar = document.getElementById('sh-progress-bar');
                const progressBuffer = document.getElementById('sh-progress-buffer');
                const progressHandle = document.getElementById('sh-progress-handle');
                const volumeBtn = document.getElementById('sh-volume-btn');
                const volumeIcon = document.getElementById('sh-volume-icon');

                const fullBtn = document.getElementById('sh-full-btn');
                const loadingSpinner = document.getElementById('sh-loading');
                const controls = document.getElementById('sh-controls');
                const offlineScreen = document.getElementById('offline-screen');
                const qualityBtn = document.getElementById('sh-quality-btn');
                const qualityMenu = document.getElementById('sh-quality-menu');

                let hls = null;
                let scrubbing = false;
                let controlsTimeout = null;
                let pollInterval = null;
                let hlsRetryCount = 0;
                let hlsRetryTimer = null;
                const MAX_HLS_RETRIES = 15;

                function showOffline() {
                    offlineScreen.style.display = 'flex';
                    hideLoading();
                    if (hls) {
                        hls.destroy();
                        hls = null;
                    }
                    video.pause();
                    updatePlayIcon();
                }

                function hideOffline() {
                    offlineScreen.style.display = 'none';
                }

                function showLoading() {
                    loadingSpinner.style.display = 'block';
                }
                function hideLoading() {
                    loadingSpinner.style.display = 'none';
                }

                const currentStreamKey = '<%= typeof streamKey !== "undefined" ? streamKey : "default" %>';

                window.checkStreamStatus = function () {
                    showLoading();
                    fetch('/live/status/' + currentStreamKey)
                        .then(res => res.json())
                        .then(data => {
                            if (data.live) {
                                initHlsPlayer();
                            } else {
                                showOffline();
                            }
                        })
                        .catch(err => {
                            console.warn('Status check failed:', err);
                            showOffline();
                        });
                };

                // Connect to Status WebSocket channel for instant real-time live status travel
                function connectStatusWebSocket() {
                    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                    const wsUrl = `${protocol}//${window.location.host}/status-ws?key=${encodeURIComponent(currentStreamKey)}`;

                    const ws = new WebSocket(wsUrl);

                    ws.onmessage = (event) => {
                        try {
                            const data = JSON.parse(event.data);
                            if (data.type === 'STATUS') {
                                if (data.live) {
                                    // Delay HLS init to give FFmpeg time to generate the first segment
                                    showLoading();
                                    hideOffline();
                                    setTimeout(() => {
                                        initHlsPlayer();
                                    }, 4000);
                                } else {
                                    showOffline();
                                }
                            }
                        } catch (err) {
                            console.warn('Status WebSocket message parse error:', err);
                        }
                    };

                    ws.onclose = () => {
                        setTimeout(connectStatusWebSocket, 3000);
                    };

                    ws.onerror = (err) => {
                        console.warn('Status WebSocket error:', err);
                    };
                }

                function initHlsPlayer() {
                    const streamUrl = '<%= hlsBaseUrl %>/master.m3u8';

                    // Clear any pending retry timer
                    if (hlsRetryTimer) { clearTimeout(hlsRetryTimer); hlsRetryTimer = null; }

                    if (Hls.isSupported()) {
                        if (hls) {
                            hls.destroy();
                            hls = null;
                        }

                        hls = new Hls({
                            liveSyncDurationCount: 4,          // 8-second live sync buffer cushion
                            liveMaxLatencyDurationCount: 10,   // Up to 20s latency tolerance before jumping
                            maxLiveSyncPlaybackRate: 1.0,      // Never pitch shift or speed up audio
                            enableWorker: true,
                            lowLatencyMode: false,
                            progressive: true,                 // Enable progressive chunk streaming
                            backBufferLength: 30,              // Keep 30s back-buffer
                            maxBufferLength: 30,               // Pre-download up to 30 seconds ahead
                            maxMaxBufferLength: 60,            // Allow buffer growth up to 60 seconds
                            startLevel: -1,                    // Auto quality selection by default
                            abrEwmaDefaultEstimate: 3000000,   // Initial bandwidth estimate for ABR
                            abrBandWidthUpFactor: 0.7,
                            abrBandWidthFactor: 0.8,
                            manifestLoadingTimeOut: 5000,
                            manifestLoadingMaxRetry: 5,
                            manifestLoadingRetryDelay: 1000,
                            levelLoadingTimeOut: 5000,
                            levelLoadingMaxRetry: 5,
                            levelLoadingRetryDelay: 1000,
                            fragLoadingTimeOut: 10000,
                            fragLoadingMaxRetry: 6,
                            fragLoadingRetryDelay: 1000
                        });

                        hls.loadSource(streamUrl);
                        hls.attachMedia(video);

                        hls.on(Hls.Events.MANIFEST_PARSED, () => {
                            hlsRetryCount = 0;
                            hideOffline();
                            hideLoading();
                            video.play().then(() => {
                                updatePlayIcon();
                            }).catch(err => {
                                console.warn('Autoplay prevented:', err);
                                updatePlayIcon();
                            });
                        });

                        hls.on(Hls.Events.ERROR, (event, data) => {
                            if (data.fatal) {
                                console.warn('HLS Fatal Error:', data.type, data.details);
                                if (data.type === Hls.ErrorTypes.NETWORK_ERROR) {
                                    // master.m3u8 might not exist yet — retry with backoff
                                    hlsRetryCount++;
                                    if (hlsRetryCount <= MAX_HLS_RETRIES) {
                                        console.log(`[HLS] Retry ${hlsRetryCount}/${MAX_HLS_RETRIES} in 2s (waiting for FFmpeg to generate segments)...`);
                                        showLoading();
                                        hls.destroy();
                                        hls = null;
                                        hlsRetryTimer = setTimeout(() => {
                                            initHlsPlayer();
                                        }, 2000);
                                    } else {
                                        console.warn('[HLS] Max retries reached, showing offline');
                                        hlsRetryCount = 0;
                                        showOffline();
                                    }
                                } else if (data.type === Hls.ErrorTypes.MEDIA_ERROR) {
                                    hls.recoverMediaError();
                                } else {
                                    hlsRetryCount++;
                                    if (hlsRetryCount <= MAX_HLS_RETRIES) {
                                        hls.destroy();
                                        hls = null;
                                        hlsRetryTimer = setTimeout(() => initHlsPlayer(), 2000);
                                    } else {
                                        hlsRetryCount = 0;
                                        showOffline();
                                    }
                                }
                            }
                        });
                    } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                        video.src = streamUrl;
                        video.addEventListener('loadedmetadata', () => {
                            hideOffline();
                            hideLoading();
                            video.play();
                            updatePlayIcon();
                        });
                    }
                }

                // Quality Selection — Auto lets ABR decide, manual pins to specific rendition
                window.setQuality = function (targetHeight) {
                    if (hls && hls.levels && hls.levels.length > 0) {
                        if (targetHeight === -1) {
                            hls.currentLevel = -1;
                            hls.nextLevel = -1;
                            hls.loadLevel = -1;
                        } else {
                            let idx = hls.levels.findIndex(l => l.height === targetHeight);
                            if (idx === -1) idx = hls.levels.findIndex(l => l.attrs && l.attrs.NAME && l.attrs.NAME.includes(targetHeight + 'p'));
                            if (idx !== -1) {
                                hls.currentLevel = idx;
                                hls.nextLevel = idx;
                                hls.loadLevel = idx;
                            }
                        }
                    }
                    const items = document.querySelectorAll('.sh-quality-item');
                    items.forEach(i => { i.classList.remove('selected'); const c = i.querySelector('.fa-check'); if (c) c.classList.add('hidden'); });
                    const sel = document.querySelector(`[data-quality="${targetHeight === -1 ? 'auto' : targetHeight}"]`);
                    if (sel) { sel.classList.add('selected'); const c = sel.querySelector('.fa-check'); if (c) c.classList.remove('hidden'); }
                    qualityMenu.classList.remove('active');
                };

                qualityBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    qualityMenu.classList.toggle('active');
                });

                document.addEventListener('click', () => {
                    qualityMenu.classList.remove('active');
                });

                function formatTime(sec) {
                    if (!sec || !isFinite(sec)) return '00:00';
                    const s = Math.floor(sec % 60);
                    const m = Math.floor(sec / 60);
                    return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
                }

                function updatePlayIcon() {
                    if (video.paused) {
                        playIcon.className = 'fas fa-play';
                        playBtn.setAttribute('aria-label', 'Play');
                    } else {
                        playIcon.className = 'fas fa-pause';
                        playBtn.setAttribute('aria-label', 'Pause');
                    }
                }

                playBtn.addEventListener('click', () => {
                    if (video.paused) {
                        video.muted = false;
                        video.play().catch(e => console.warn("Play error:", e));
                        if (volumeIcon) volumeIcon.className = 'fas fa-volume-up';
                    } else {
                        video.pause();
                    }
                    resetControlsTimer();
                });

                // Enforce strict 1.0x playback speed & pitch preservation (Never fast-forward or pitch shift)
                video.preservesPitch = true;
                if ('webkitPreservesPitch' in video) video.webkitPreservesPitch = true;
                if ('mozPreservesPitch' in video) video.mozPreservesPitch = true;

                video.addEventListener('ratechange', () => {
                    if (video.playbackRate !== 1.0) {
                        video.playbackRate = 1.0;
                    }
                });

                video.addEventListener('play', updatePlayIcon);
                video.addEventListener('pause', updatePlayIcon);

                let loadingDebounce = null;

                video.addEventListener('waiting', () => {
                    if (loadingDebounce) clearTimeout(loadingDebounce);
                    loadingDebounce = setTimeout(() => {
                        if (video.readyState < 3 && !video.paused) {
                            showLoading();
                        }
                    }, 300);
                });

                video.addEventListener('playing', () => {
                    if (loadingDebounce) clearTimeout(loadingDebounce);
                    hideLoading();
                });

                video.addEventListener('canplay', () => {
                    if (loadingDebounce) clearTimeout(loadingDebounce);
                    hideLoading();
                });

                video.addEventListener('timeupdate', () => {
                    const ct = video.currentTime || 0;
                    const dur = video.duration || 0;
                    currentTimeEl.textContent = formatTime(ct);

                    if (dur > 0) {
                        const percent = (ct / dur) * 100;
                        progressBar.style.width = percent + '%';
                        progressHandle.style.left = percent + '%';
                    }

                    if (video.readyState >= 3) {
                        if (loadingDebounce) clearTimeout(loadingDebounce);
                        hideLoading();
                    }
                });

                function toggleFullscreen() {
                    if (
                        document.fullscreenElement ||
                        document.webkitFullscreenElement ||
                        document.mozFullScreenElement ||
                        document.msFullscreenElement
                    ) {
                        exitFullscreen();
                    } else {
                        enterFullscreen();
                    }
                }

                function enterFullscreen() {
                    const element = player;

                    if (element.requestFullscreen) {
                        element.requestFullscreen();
                    } else if (element.mozRequestFullScreen) {
                        element.mozRequestFullScreen();
                    } else if (element.webkitRequestFullscreen) {
                        element.webkitRequestFullscreen(Element.ALLOW_KEYBOARD_INPUT);
                    } else if (element.msRequestFullscreen) {
                        element.msRequestFullscreen();
                    }

                    resetControlsTimer();
                }

                function exitFullscreen() {
                    if (document.exitFullscreen) {
                        document.exitFullscreen();
                    } else if (document.mozCancelFullScreen) {
                        document.mozCancelFullScreen();
                    } else if (document.webkitExitFullscreen) {
                        document.webkitExitFullscreen();
                    } else if (document.msExitFullscreen) {
                        document.msExitFullscreen();
                    }

                    resetControlsTimer();
                }

                fullBtn.addEventListener('click', toggleFullscreen);

                function resetControlsTimer() {
                    clearTimeout(controlsTimeout);
                    controls.style.opacity = '1';
                    controls.style.transform = 'translateY(0)';
                    controls.style.pointerEvents = 'auto';

                    if (!video.paused) {
                        controlsTimeout = setTimeout(() => {
                            if (!scrubbing) {
                                controls.style.opacity = '0';
                                controls.style.transform = 'translateY(10px)';
                                controls.style.pointerEvents = 'none';
                            }
                        }, 3000);
                    }
                }

                player.addEventListener('mousemove', () => {
                    resetControlsTimer();
                });

                // Start status WebSocket and check stream status
                connectStatusWebSocket();
                checkStreamStatus();
                pollInterval = setInterval(() => {
                    if (offlineScreen.style.display !== 'none') {
                        checkStreamStatus();
                    }
                }, 5000);
            })();
    </script>
</body>

</html>
