<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title><%= stream.title %> | CoWatch Player</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: '#82A3A1',
                        'accent-dark': '#465362',
                        secondary: '#9FC490',
                        'control-bg': 'rgba(18, 22, 26, 0.95)',
                        'glass-bg': 'rgba(70, 83, 98, 0.4)',
                        'glass-border': 'rgba(130, 163, 161, 0.25)',
                    },
                    animation: {
                        'spin-slow': 'spin 1s linear infinite',
                        'pulse-slow': 'pulse 2s ease-in-out infinite',
                    },
                    backdropBlur: {
                        'glass': '10px',
                    },
                }
            }
        }
    </script>
    <style>
        :root {
            --progress-bg: #2a323b;
            --progress-fill: #82A3A1;
            --value: 100%;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000000;
        }

        .sh-player {
            width: 100%;
            max-width: 100%;
            max-height: 100dvh;
            aspect-ratio: 16/9;
            background: #000;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
            transition: all 0.3s ease;
        }

        @media (min-width: 1200px) {
            .sh-player {
                max-width: 1200px;
                border-radius: 12px;
            }
        }

        :fullscreen .sh-player,
        :-webkit-full-screen .sh-player,
        :-moz-full-screen .sh-player {
            border-radius: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            max-height: none !important;
            aspect-ratio: auto !important;
        }

        #sh-controls {
            padding-bottom: calc(env(safe-area-inset-bottom) + 1.25rem) !important;
        }

        .sh-quality-menu {
            display: none;
            position: absolute;
            bottom: 4rem;
            right: 1.5rem;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 0.5rem;
            z-index: 50;
            min-width: 160px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        }

        .sh-quality-menu.active {
            display: block;
        }

        .sh-quality-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem 0.75rem;
            color: #cbd5e1;
            font-size: 0.85rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .sh-quality-item:hover {
            background: rgba(99, 102, 241, 0.2);
            color: #ffffff;
        }

        .sh-quality-item.selected {
            color: #818cf8;
            background: rgba(99, 102, 241, 0.15);
        }
    </style>
</head>

<body class="flex items-center justify-center bg-black">

    <div class="sh-player group" id="sh-player-container">

        <!-- HTML5 Video Element -->
        <video id="sh-video" class="w-full h-full object-contain cursor-pointer" playsinline webkit-playsinline autoplay></video>

        <!-- Loading Spinner -->
        <div id="sh-loading" class="absolute inset-0 flex items-center justify-center bg-black/60 backdrop-blur-sm z-30 pointer-events-none transition-opacity duration-300">
            <div class="flex flex-col items-center gap-3">
                <div class="w-12 h-12 border-4 border-indigo-500/30 border-t-indigo-500 rounded-full animate-spin"></div>
                <span class="text-xs font-semibold text-slate-300 tracking-wider uppercase">Loading Stream...</span>
            </div>
        </div>

        <!-- Stream Offline Overlay -->
        <div id="offline-screen" class="absolute inset-0 bg-slate-950 flex flex-col items-center justify-center p-6 text-center z-40" style="display: none;">
            <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 text-2xl mb-4">
                <i class="fa-solid fa-satellite-dish animate-pulse"></i>
            </div>
            <h2 class="text-2xl font-bold text-white mb-2">Stream Offline</h2>
            <p class="text-slate-400 text-xs max-w-sm mb-6">
                The broadcaster is currently offline or reconnecting. The player will automatically resume when live.
            </p>
            <button onclick="checkStreamStatus()" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-all shadow-lg shadow-indigo-600/30 flex items-center gap-2">
                <i class="fa-solid fa-rotate-right"></i>
                <span>Refresh Status</span>
            </button>
        </div>

        <!-- Top Header Info Bar -->
        <div class="absolute top-0 left-0 right-0 p-4 sm:p-6 bg-gradient-to-b from-black/80 via-black/40 to-transparent flex items-center justify-between z-20 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="flex items-center gap-2 pointer-events-auto">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-500/20 text-red-400 border border-red-500/30 flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span> LIVE
                </span>
                <span id="quality-badge" class="px-2 py-0.5 rounded text-[10px] font-mono bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">Auto</span>
            </div>
        </div>

        <!-- Custom Player Controls Bar -->
        <div id="sh-controls" class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-20 flex flex-col gap-3 transition-all duration-300 opacity-0 group-hover:opacity-100">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <button id="sh-play-btn" class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-base transition-colors">
                        <i class="fa-solid fa-play" id="sh-play-icon"></i>
                    </button>
                    <button id="sh-mute-btn" class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-base transition-colors">
                        <i class="fa-solid fa-volume-high" id="sh-mute-icon"></i>
                    </button>
                    <span id="sh-current-time" class="text-xs font-mono text-slate-300 font-semibold">00:00</span>
                </div>

                <div class="flex items-center gap-3 relative">
                    <!-- Quality Gear Button -->
                    <button id="sh-quality-btn" class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-base transition-colors" title="Quality Settings">
                        <i class="fa-solid fa-gear"></i>
                    </button>

                    <!-- Quality Dropdown Menu -->
                    <div id="sh-quality-menu" class="sh-quality-menu">
                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-3 py-1 mb-1 border-b border-white/10">Video Quality</div>
                        <div class="sh-quality-item selected" data-quality="auto" onclick="setQuality(-1)">
                            <span>Auto (ABR)</span>
                            <i class="fa-solid fa-check text-xs"></i>
                        </div>
                        <div class="sh-quality-item" data-quality="0" onclick="setQuality(0)">
                            <span>1080p HD</span>
                            <i class="fa-solid fa-check text-xs hidden"></i>
                        </div>
                        <div class="sh-quality-item" data-quality="1" onclick="setQuality(1)">
                            <span>720p HD</span>
                            <i class="fa-solid fa-check text-xs hidden"></i>
                        </div>
                        <div class="sh-quality-item" data-quality="2" onclick="setQuality(2)">
                            <span>480p SD</span>
                            <i class="fa-solid fa-check text-xs hidden"></i>
                        </div>
                    </div>

                    <!-- Fullscreen Button -->
                    <button id="sh-full-btn" class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-base transition-colors">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                </div>
            </div>
        </div>

    </div>

    <script>
        (function () {
            const player = document.getElementById('sh-player-container');
            const video = document.getElementById('sh-video');
            const playBtn = document.getElementById('sh-play-btn');
            const playIcon = document.getElementById('sh-play-icon');
            const muteBtn = document.getElementById('sh-mute-btn');
            const muteIcon = document.getElementById('sh-mute-icon');
            const currentTimeEl = document.getElementById('sh-current-time');
            const fullBtn = document.getElementById('sh-full-btn');
            const loadingSpinner = document.getElementById('sh-loading');
            const controls = document.getElementById('sh-controls');
            const offlineScreen = document.getElementById('offline-screen');
            const qualityBtn = document.getElementById('sh-quality-btn');
            const qualityMenu = document.getElementById('sh-quality-menu');
            const viewersCountPill = document.getElementById('viewers-count-pill');
            const qualityBadge = document.getElementById('quality-badge');

            const currentStreamKey = '<%= typeof streamKey !== "undefined" ? streamKey : "default" %>';
            const masterUrl = `/live-playlist/${encodeURIComponent(currentStreamKey)}/master.m3u8`;

            let hls = null;
            let statusWs = null;

            function showOffline() {
                offlineScreen.style.display = 'flex';
                hideLoading();
                if (hls) { hls.destroy(); hls = null; }
                video.pause();
                updatePlayIcon();
            }

            function hideOffline() {
                offlineScreen.style.display = 'none';
            }

            function showLoading() {
                loadingSpinner.style.display = 'flex';
            }

            function hideLoading() {
                loadingSpinner.style.display = 'none';
            }

            function initHlsPlayer() {
                if (hls) { hls.destroy(); hls = null; }
                showLoading();
                hideOffline();

                if (Hls.isSupported()) {
                    hls = new Hls({
                        enableWorker: true,
                        lowLatencyMode: false,
                        liveSyncDurationCount: 3,
                        liveMaxLatencyDurationCount: 8,
                        backBufferLength: 60,
                        maxBufferLength: 30,
                        maxMaxBufferLength: 60,
                        manifestLoadingTimeOut: 10000,
                        manifestLoadingMaxRetry: 10,
                        manifestLoadingRetryDelay: 500,
                        levelLoadingTimeOut: 10000,
                        levelLoadingMaxRetry: 10,
                        levelLoadingRetryDelay: 500,
                        fragLoadingTimeOut: 10000,
                        fragLoadingMaxRetry: 10,
                        fragLoadingRetryDelay: 500
                    });

                    hls.loadSource(masterUrl);
                    hls.attachMedia(video);

                    hls.on(Hls.Events.MANIFEST_PARSED, (event, data) => {
                        hideOffline();
                        hideLoading();
                        video.play().then(() => updatePlayIcon()).catch(() => updatePlayIcon());
                    });

                    hls.on(Hls.Events.LEVEL_SWITCHED, (event, data) => {
                        const level = hls.levels[data.level];
                        if (level && qualityBadge) {
                            qualityBadge.textContent = `${level.height || '1080'}p ${hls.autoLevelEnabled ? '(Auto)' : ''}`;
                        }
                    });

                    hls.on(Hls.Events.ERROR, (event, data) => {
                        if (data.fatal) {
                            switch (data.type) {
                                case Hls.ErrorTypes.NETWORK_ERROR:
                                    console.warn('Network error, retrying HLS manifest...');
                                    setTimeout(() => { if (hls) hls.loadSource(masterUrl); }, 1000);
                                    break;
                                case Hls.ErrorTypes.MEDIA_ERROR:
                                    console.warn('Media error, recovering...');
                                    hls.recoverMediaError();
                                    break;
                                default:
                                    showOffline();
                                    break;
                            }
                        }
                    });
                } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                    video.src = masterUrl;
                    video.play().then(() => updatePlayIcon()).catch(() => updatePlayIcon());
                }
            }

            window.setQuality = function (levelIndex) {
                if (!hls) return;
                hls.currentLevel = levelIndex; // -1 for Auto, 0 for 1080p, 1 for 720p, 2 for 480p

                const items = document.querySelectorAll('.sh-quality-item');
                items.forEach(i => { i.classList.remove('selected'); const c = i.querySelector('.fa-check'); if (c) c.classList.add('hidden'); });
                const sel = document.querySelector(`[data-quality="${levelIndex === -1 ? 'auto' : levelIndex}"]`);
                if (sel) { sel.classList.add('selected'); const c = sel.querySelector('.fa-check'); if (c) c.classList.remove('hidden'); }
                qualityMenu.classList.remove('active');
            };

            qualityBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                qualityMenu.classList.toggle('active');
            });

            document.addEventListener('click', () => {
                qualityMenu.classList.remove('active');
            });

            function formatTime(sec) {
                if (!sec || !isFinite(sec)) return '00:00';
                const s = Math.floor(sec % 60);
                const m = Math.floor(sec / 60);
                return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
            }

            function updatePlayIcon() {
                if (video.paused) {
                    playIcon.className = 'fa-solid fa-play';
                    playBtn.setAttribute('aria-label', 'Play');
                } else {
                    playIcon.className = 'fa-solid fa-pause';
                    playBtn.setAttribute('aria-label', 'Pause');
                }
            }

            playBtn.addEventListener('click', () => {
                if (video.paused) video.play();
                else video.pause();
                updatePlayIcon();
            });

            video.addEventListener('click', () => {
                if (video.paused) video.play();
                else video.pause();
                updatePlayIcon();
            });

            muteBtn.addEventListener('click', () => {
                video.muted = !video.muted;
                muteIcon.className = video.muted ? 'fa-solid fa-volume-xmark' : 'fa-solid fa-volume-high';
            });

            video.addEventListener('timeupdate', () => {
                currentTimeEl.textContent = formatTime(video.currentTime || 0);
            });

            async function toggleFullscreen() {
                if (document.fullscreenElement || document.webkitFullscreenElement) {
                    try {
                        if (document.exitFullscreen) await document.exitFullscreen();
                        else if (document.webkitExitFullscreen) await document.webkitExitFullscreen();
                    } catch (e) {}
                    if (screen.orientation && typeof screen.orientation.unlock === 'function') {
                        try { screen.orientation.unlock(); } catch (e) {}
                    }
                } else {
                    try {
                        if (player.requestFullscreen) await player.requestFullscreen();
                        else if (player.webkitRequestFullscreen) await player.webkitRequestFullscreen();
                    } catch (e) {}
                    if (screen.orientation && typeof screen.orientation.lock === 'function') {
                        try { await screen.orientation.lock('landscape'); } catch (e) {}
                    }
                }
            }

            fullBtn.addEventListener('click', toggleFullscreen);

            function connectStatusWebSocket() {
                const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                const wsUrl = `${protocol}//${window.location.host}/status-ws?key=${encodeURIComponent(currentStreamKey)}&role=viewer`;
                statusWs = new WebSocket(wsUrl);

                statusWs.onmessage = (event) => {
                    try {
                        const data = JSON.parse(event.data);
                        if (data.type === 'STATUS') {
                            if (viewersCountPill && typeof data.viewers !== 'undefined') {
                                viewersCountPill.textContent = `👁️ ${data.viewers} Viewer${data.viewers === 1 ? '' : 's'}`;
                            }
                            if (data.live) {
                                hideOffline();
                                if (!hls) initHlsPlayer();
                            } else {
                                showOffline();
                            }
                        }
                    } catch (err) {}
                };

                statusWs.onclose = () => setTimeout(connectStatusWebSocket, 3000);
            }

            window.checkStreamStatus = function () {
                showLoading();
                fetch('/live/status/' + currentStreamKey)
                    .then(res => res.json())
                    .then(data => {
                        if (data.live) {
                            initHlsPlayer();
                        } else {
                            showOffline();
                        }
                    })
                    .catch(() => showOffline());
            };

            connectStatusWebSocket();
            checkStreamStatus();
        })();
    </script>
</body>

</html>
